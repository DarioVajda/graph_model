{
  // ───────────────────────────────────────────────────────────────────────────
  // The `anneal` fork that closes a ChEBI-20 specialist trunk. One file for all
  // three cells of `probes/010_chebi_specialist.jsonc`; a fork is a separate
  // submission per cell and is not part of the chain.
  //
  //   GPU=1 INDUCTOR_CACHE=.inductor_cache/chebi_specialist \
  //   src/generalist/tools/launch/run_cli.sh fork \
  //     --from src/generalist/results/runs/chebi_specialist_graph_s0/checkpoint-5000 \
  //     --mode anneal \
  //     --fork-config src/generalist/configs/forks/anneal_chebi_specialist.jsonc \
  //     --config src/generalist/configs/probes/010_chebi_specialist.jsonc \
  //     --cell chebi_specialist_graph_s0
  //
  // WHAT IT PRODUCES. The reportable model, as everywhere else in this campaign:
  // the trunk runs WSD's stable phase at a flat LR, so its last checkpoint is
  // mid-schedule by construction. `min_factor` is left to the run config's
  // `lr_min` (`lr/10`). At the default decay fraction of 10 % this is 500 steps
  // on the 5,000-step trunk.
  //
  // WHY `passes` IS RAISED, and why only by two. `max_steps` binds this run well
  // before the mixture's fifteen-pass cap does — 5,000 steps is about twelve
  // passes of the ChEBI train pool — so the decay has headroom the molecule
  // generalist's anneal did not, where BACE, BBBP and ChEBI all ended at exactly
  // 6.00 epochs and the fork had to buy the tail outright. Two more passes is
  // insurance against the examples/step coming in lower than estimated and the
  // trunk therefore ending nearer its cap; it costs nothing if unused, because a
  // corpus's passes are re-walks rather than files on disk (`mol/chebi20` is a
  // corpus, not a generator, so `tools/campaign/build_g2s_tail.py`'s problem does not
  // arise here).
  //
  // `eval_steps` 250 gives the decay a midpoint and an endpoint. The number that
  // matters is not either of them — it is scored after the leg by
  // `tools/chebi_report.py` over the whole 3,300-molecule benchmark split, which
  // is the only ChEBI-20 measurement in this repository that a published row may
  // be placed beside.
  // ───────────────────────────────────────────────────────────────────────────

  "passes": {
    "mol/chebi20": 17
  },

  "eval_steps": 250
}
