{
  // ───────────────────────────────────────────────────────────────────────────
  // The graph-domain smoke: the six adapters of `GRAPH_GENERALIST.md` §2 through
  // the real `validate` -> `data_prep` -> `train` path, one task from each.
  //
  //   python3 -m src.generalist validate  --config src/generalist/configs/probes/014_graph_smoke.jsonc
  //   python3 -m src.generalist data_prep --config src/generalist/configs/probes/014_graph_smoke.jsonc
  //   python3 -m src.generalist train     --config src/generalist/configs/probes/014_graph_smoke.jsonc
  //
  // It is a plumbing check and never a result. `adapter_options.*.limit` caps
  // every split, which is inside each domain's build version, so a limited
  // build can never be read as the real one.
  //
  // The mixture covers both task kinds and the three answer kinds the graph
  // domains add — `span` (GraphQA, TAG), `yesno` (probes, expressiveness,
  // `our_tests`) and `entities` (KGQA, generated) — and `data_prep` also builds
  // the held-out tasks of every domain it touches.
  // ───────────────────────────────────────────────────────────────────────────

  "name": "graph_smoke",
  "results_dir": "src/generalist/results",

  "execution": {
    "mode": "sbatch",
    "sbatch": {
      "granularity": "per_config",
      "max_concurrent": 1,
      "partition": "frida",
      "account": "povejmo",
      "gpus": "B200",
      "gpus_per_config": 1,
      "cpus": 16,
      "mem": "128G",
      "time": "02:00:00",
      "container": "/shared/workspace/povejmo/containers/transformers_deepspeed_latest.sqsh"
    }
  },

  "arm": "graph",
  "mixture": "graph_smoke",
  "validators": "smoke",

  "adapter_options": {
    "graphqa": {"limit": 64},
    "probes": {"limit": 64},
    "expressiveness": {"limit": 64},
    "our_tests": {"limit": 64},
    "kgqa": {"limit": 64},
    "tag": {"limit": 64}
  },

  "model_name": "meta-llama/Llama-3.2-1B-Instruct",
  "prompt_style": "chat",
  "impl": "v2-flex",
  "bias": "spd+magnetic",
  "max_spd": 32,
  "magnetic_dim": 32,
  "magnetic_q": 0.25,
  "lora": true,
  "lora_r": 16,
  "lora_dropout": 0.05,
  "question_node": "on",
  "data_seed": 0,

  "tokens_per_step": 16384,
  // A padded budget, from which the sampler derives the accumulation. The
  // configured accumulation of 4 put 64 GraphQA rows of 33 tokens in a
  // micro-batch, which the flex collator padded to 64 x 512 positions, and the
  // logits alone ran an 80 GB card out of memory (2026-10-04). 8,192 padded
  // tokens is what then ran clean at a hand-set accumulation of 16.
  "micro_batch_tokens": 8192,
  // A step count, not the budget rule, and no D2.2 floor: 64-row sources would
  // trip both, and neither is what this checks. The same 64-row sources run out
  // inside 60 steps (GraphQA at about step 45), which is fine for a smoke.
  "max_steps": 60,
  "min_examples_per": 0,
  "allow_exhaustion": true,

  "lr": 3e-4,
  "bias_lr": 1e-2,
  "lr_min": 3e-5,
  "warmup_steps": 10,
  "rewarm_steps": 10,
  "weight_decay": 0.1,

  "save_steps": 30,
  "save_total_limit": 2,
  "logging_steps": 1,
  "milestone_steps": 30,

  "seed": 0,
  "wandb_project": null
}
