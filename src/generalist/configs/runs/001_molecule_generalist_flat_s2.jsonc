{
  // ───────────────────────────────────────────────────────────────────────────
  // Arm 2, flat, seed 2. Identical to `001_molecule_generalist_flat_s0.jsonc` in
  // every field but `seed` and `name`; see that file for the token budget and
  // `..._graph_s0.jsonc` for the recipe.
  //
  //   src/generalist/tools/chain.sh src/generalist/configs/runs/001_molecule_generalist_flat_s2.jsonc
  // ───────────────────────────────────────────────────────────────────────────

  "name": "molecule_generalist_flat_s2",
  "results_dir": "src/generalist/results",

  "execution": {
    "mode": "sbatch",
    "sbatch": {
      "granularity": "per_config",
      "max_concurrent": 1,
      "partition": "frida",
      "account": "povejmo",
      "gpus": ["B300", "B200"],
      "gpus_per_config": 1,
      "cpus": 16,
      "mem": "128G",
      "time": "12:00:00",
      "inductor_cache": ".inductor_cache/generalist",
      "container": "/shared/workspace/povejmo/containers/transformers_deepspeed_latest.sqsh"
    }
  },

  "chain": {
    "chunks": 3,
    "dependency": "afterany"
  },

  "arm": "flat",
  "mixture": "molecule_generalist",
  "validators": "default",

  "model_name": "meta-llama/Llama-3.2-1B",
  "impl": "v2-flex",
  "bias": "none",
  "max_spd": 32,
  "magnetic_dim": 32,
  "magnetic_q": 0.25,
  "lora": true,
  "lora_r": 16,
  "lora_dropout": 0.05,

  "encoding": "rich_levi",
  "stereo_tags": true,
  "question_node": "on",
  "ordering": "rcm",
  "max_length": 512,
  "tier_a_cap_per_pass": 4000,
  "g2s_cap_per_pass": 4000,
  "held_out_size": 1000,
  "chebi_heavy_atom_cap": 64,
  "chebi_allow_disconnected": false,
  "data_seed": 0,

  "tokens_per_step": 4689,
  "accumulation_steps": 8,
  "loss_norm": "per_example",
  "max_steps": 5599,
  "lr": 1e-4,
  "bias_lr": 1e-2,
  "lr_min": 1e-5,
  "warmup_steps": 200,
  "rewarm_steps": 200,
  "weight_decay": 0.1,

  "save_steps": 500,
  "save_total_limit": 3,
  "logging_steps": 10,
  "milestone_steps": 2000,

  "seed": 2,
  "wandb_project": null
}
