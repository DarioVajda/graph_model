{
  // ─────────────────────────────────────────────────────────────────────────
  // MIXED_BIAS.md Phase 2 on WebQSP — does a non-linear MAGNITUDE channel
  // recover what linearization costs?
  //
  // 015 established the number this sweep has to beat: read at the mask setting
  // a factorized backbone could actually run (intra-node diagonal KEPT), the
  // linear head leaves 1.42 pp on the table against the MLP head — 5.6% of the
  // magnetic headroom. MIXED_BIAS.md §1 argues the only non-linearity a bilinear
  // form admits is a per-NODE one, and §2.3 derives the one per-node magnitude
  // feature that is invariant to both eigenbasis ambiguities.
  //
  // ── arms (MIXED_BIAS.md §5.1) ────────────────────────────────────────────
  //   1  magnetic,           mask ON    the incumbent target (the ceiling)
  //   2  magnetic_linear,    mask off   cost of losing non-linear routing
  //   3  magnetic_magnitude, mask off   cost of losing directed distance/flow
  //   4  magnetic_hybrid,    mask off   the proposed O(N) replacement
  //
  // Each arm at the mask setting it could actually SHIP with. Arms 2-4 run
  // unmasked because an inner product yields <q_i, k_i> and cannot be forced to
  // zero — unmasked is the only configuration a factorized backbone can run.
  // Arm 1 keeps the mask because it is the legacy method and can implement one.
  // Phase 3 established this is not a free choice and that its sign is
  // head-dependent: on WebQSP the diagonal is worth +2.47 pp to the linear head
  // and -1.74 pp to the MLP head.
  //
  // Arm 0 (no soft bias) is NOT re-run: with no bias module there is nothing for
  // M or the mask to change. 010's floor (test F1 0.4580, same recipe, same
  // data, 3 seeds) is the headroom denominator.
  //
  // ── M = 64, and why arms 1 and 2 are re-run ──────────────────────────────
  // 128 is not a shippable operating point: it puts the tandem at 2M +
  // d_magnitude = 320 appended dims, 5x Llama-1B's head_dim, against 192 (3x) at
  // 64 — and 010's Conclusion 4 already found 64 free for the linear head here.
  // Measuring at a width the optimized version would never run is the same error
  // Phase 3 caught with the diagonal mask.
  //
  // That costs both controls: 015 ran M=128 only, and 010 has the linear head at
  // 64 but MASKED. Neither exists at the configuration this sweep needs, so arms
  // 1 and 2 are re-measured here rather than quoted. The sweep is therefore
  // self-contained on this dataset, and 015's numbers serve only as a
  // cross-check that M=64 behaves as 010 predicted.
  //
  // magnetic_m_collate is collator-only and outside data_config_key, so this
  // reuses 015's build byte-for-byte — no rebuild.
  //
  // ── bias_lr is swept, not pinned ─────────────────────────────────────────
  // 010's Conclusion 5: the linear head wanted ~4x the MLP head's LR, and a
  // shared LR prices optimization rather than math. Arms 3 and 4 have parameter
  // counts unlike either incumbent (a 1.3M magnitude channel against the MLP
  // head's 590k), so neither existing optimum can be assumed. Each arm is read
  // at its own best. bias_lr rides INSIDE the bundle because it is not
  // independent of the arm.
  //
  // 4 arms x 2 bias_lr x 3 seeds = 24 runs, ~2.8 GPU-h each (sacct, 010/015)
  // = ~67 GPU-h.
  //
  //   python3 -m sweep src.experiments.kgqa src/experiments/mixed_bias/configs/018_webqsp_mixed.jsonc
  //   python3 -m sweep.report src/experiments/mixed_bias/results/018_webqsp_mixed
  // ─────────────────────────────────────────────────────────────────────────

  "name": "018_webqsp_mixed",
  "results_dir": "src/experiments/mixed_bias/results",

  "execution": {
    "mode": "sbatch",
    "sbatch": {
      "granularity": "per_config",
      "max_concurrent": 16,
      "partition": "frida",
      "account": "povejmo",
      // H100. The list form renders as `--gres gpu:1 --constraint GPU_BRD:H100`
      // rather than pinning the gres TYPE, which is the more robust of the two.
      // Note the cluster has exactly one H100 node (ixh, 8 GPUs), so the
      // effective concurrency here is 8 whatever max_concurrent says — and that
      // absolute step times are NOT comparable to 015's, which ran on B200/B300.
      // Accuracy, the only thing read here, is unaffected.
      "gpus": ["H100"],
      "gpus_per_config": 1,
      "cpus": 8,
      // 128G, NOT the 64G inherited from 015. At 64G, four baseline runs were
      // OOM-killed at ~3 h with MaxRSS pinned to 67 048 xxx K against the
      // 67 108 864 K cgroup cap — i.e. they hit the ceiling exactly. The context
      // sweep, which asks for 128G, peaked at 70 GiB on the same code, so 64G was
      // never enough for this workload class and 015 was running on the edge.
      // Host RAM, not GPU: the failure is the OOM killer, and it has nothing to do
      // with which bias arm is active.
      "mem": "128G",
      // 12 h, NOT the 24 h inherited from 015. `sacct` on 015 puts the actual
      // runs at 2:58-4:48, so 24 h was ~5x the worst observed — and on this
      // cluster an over-long walltime is not free. ixh is the only H100 node and
      // it sits `PLANNED` for a queued 8-GPU job, so its idle GPUs are only
      // reachable by backfill, i.e. by a job that provably finishes before that
      // job's computed StartTime. At 24 h nothing here fitted and the whole array
      // waited; at 12 h it does, with 2.5x margin over the worst measured run.
      "time": "12:00:00",
      "container": "/shared/workspace/povejmo/containers/transformers_deepspeed_latest.sqsh"
    }
  },

  // ── axes ──────────────────────────────────────────────────────────────────
  "seed": [0, 1, 2],

  // A BUNDLE: each object is one coherent arm. The head flag, the mask and the
  // LR ride together rather than crossing, so no run can be generated with two
  // heads enabled or with a mask setting the arm was never meant to have.
  // Every head flag is written explicitly in every object, even where false, so
  // the resolved JSON is self-describing rather than relying on defaults.
  "arm": [
    {"spd": false, "magnetic": true,  "magnetic_linear": false, "magnetic_magnitude": false, "magnetic_hybrid": false, "magnetic_m_collate": 64, "bias_self_node": false, "bias_lr": 5e-3},
    {"spd": false, "magnetic": true,  "magnetic_linear": false, "magnetic_magnitude": false, "magnetic_hybrid": false, "magnetic_m_collate": 64, "bias_self_node": false, "bias_lr": 2e-2},

    {"spd": false, "magnetic": false, "magnetic_linear": true,  "magnetic_magnitude": false, "magnetic_hybrid": false, "magnetic_m_collate": 64, "bias_self_node": true,  "bias_lr": 5e-3},
    {"spd": false, "magnetic": false, "magnetic_linear": true,  "magnetic_magnitude": false, "magnetic_hybrid": false, "magnetic_m_collate": 64, "bias_self_node": true,  "bias_lr": 2e-2},

    {"spd": false, "magnetic": false, "magnetic_linear": false, "magnetic_magnitude": true,  "magnetic_hybrid": false, "magnetic_m_collate": 64, "bias_self_node": true,  "bias_lr": 5e-3},
    {"spd": false, "magnetic": false, "magnetic_linear": false, "magnetic_magnitude": true,  "magnetic_hybrid": false, "magnetic_m_collate": 64, "bias_self_node": true,  "bias_lr": 2e-2},

    {"spd": false, "magnetic": false, "magnetic_linear": false, "magnetic_magnitude": false, "magnetic_hybrid": true,  "magnetic_m_collate": 64, "bias_self_node": true,  "bias_lr": 5e-3},
    {"spd": false, "magnetic": false, "magnetic_linear": false, "magnetic_magnitude": false, "magnetic_hybrid": true,  "magnetic_m_collate": 64, "bias_self_node": true,  "bias_lr": 2e-2}
  ],

  // ── magnitude-channel widths (MIXED_BIAS.md §2.5, §2.6) ───────────────────
  // d_magnitude is what Q/K append per head, so it is head width and NOT free.
  // d_magnitude_repr is internal to MLP_magnitude — evaluated once per node and
  // never seen by attention — so a wide MLP costs nothing at attention time.
  // Inert for arms 1 and 2, which build no magnitude channel.
  "magnetic_magnitude_dim": 64,
  "magnetic_magnitude_repr_dim": 256,

  // ── 015_webqsp_selfnode, verbatim below this line (bias_lr moved into the
  //    bundle, magnetic_m_collate 128 -> 64) ────────────────────────────────
  "question_node": "isolated",
  "mode": "train",
  "cvt_collapse": null,

  "dataset": "webqsp",
  "max_nodes": 512,
  "versions": 8,
  "n_max": 50,
  "data_seed": 42,
  "data_format_version": 3,

  "model_name": "meta-llama/Llama-3.2-1B",
  "rel_mode": "last_1",
  "num_epochs": 15,
  "batch_size": 2,
  "accumulation_steps": 4,
  "lr": 1e-4,
  "lora_r": 64,
  "lora_dropout": 0.15,
  "bias_weight_decay": 0.0,
  "k_hop": 0,
  "graph_attn_impl": "flex",
  "dtype": "bf16",
  "gradient_checkpointing": true,
  "num_workers": 4,

  "magnetic_shared": false,
  // max_spd stays at the built value even where spd is off: it is part of
  // data_config_key, so changing it would fork the dataset cache.
  "max_spd": 64,
  "magnetic_dim": 128,
  "magnetic_m": 128,
  "magnetic_q": 0.25,

  "eval_steps": 200,
  "gen_eval_samples": null,
  "gen_max_samples": null,
  "gen_max_new_tokens": 256,

  "wandb_project": "GraphLLM"
}
