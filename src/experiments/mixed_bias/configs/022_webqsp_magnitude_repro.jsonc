{
  // ─────────────────────────────────────────────────────────────────────────
  // 022 — does the normalized magnitude channel survive where the old one died?
  //
  // MIXED_BIAS.md §5.8 replaced the magnitude channel's bilinear form: both
  // factors are now L2-normalized per node row and a per-head gain carries the
  // range, so |b| <= |g^(h)| and the bias is exactly invariant to the scale of
  // the trunk, of s and of W_K. The correctness gate proves those PROPERTIES.
  // It cannot prove the thing that actually matters — that the channel trains —
  // and no run of the new parameterization exists.
  //
  // This is that run, and it is deliberately not a sweep. 018 left a reliable
  // reproducer behind: three cells that died on WebQSP, at known steps, under a
  // config that is reproduced here verbatim. If the fix works, these are the
  // cells it has to survive; if it does not, this costs ~4 runs instead of ~60.
  //
  // ── the cells, and why these ─────────────────────────────────────────────
  //   arm 3 magnitude @ 2e-2, seed 2   died step 741 (ep 2.48)
  //   arm 3 magnitude @ 2e-2, seed 0   died step 942 (ep 3.17)
  //   arm 4 hybrid    @ 5e-3, seed 0   died step 526 (ep 1.77)
  //
  // The seed x arm cross product also yields hybrid @ 5e-3 seed 2, which never
  // ran in 018 (it was killed at withdrawal). Kept: it is a free fourth data
  // point at the LOW learning rate, which is the setting that retired the "this
  // is a 2e-2 problem" reading in the first place.
  //
  // Arm 3 is read at 2e-2 and arm 4 at 5e-3 ON PURPOSE — those are the LRs at
  // which each arm actually died. Pairing each arm with its own death cell is
  // what makes a survival here mean something; a grid over both LRs would spend
  // half the runs on cells that were never evidence of anything.
  //
  // ── how to read it ───────────────────────────────────────────────────────
  // The verdict arrives early: every death above is before epoch 3.2, so ~1 h
  // in. But num_epochs stays at 15 and every other setting is 018's verbatim,
  // so a surviving run is a VALID 018 CELL and pools with the eventual arm-3/4
  // sweep rather than being thrown away. Stability is the question; the accuracy
  // number is free if the answer is yes.
  //
  // Watch `bias_gain_absmax` in the log line, not just the absence of NaN. It is
  // an upper bound on the whole channel (§5.8), so:
  //   g flat / plateauing          -> fixed
  //   g still climbing at ep 15    -> postponed, same trajectory as the four
  //                                   that diverged, just slower
  // A clean run with a climbing gain is NOT a pass. That distinction is the
  // whole reason the gain is one auditable scalar per head.
  //
  // Baselines: arms 0/1/2 are UNCHANGED by §5.8 (the phase channel is untouched
  // and was never normalized), so 018's and 021's numbers stand as the reference
  // and are not re-run here.
  //
  // 2 seeds x 2 arms = 4 runs, ~2.8-4.8 GPU-h each (sacct, 010/015) = ~14 GPU-h.
  //
  //   python3 -m sweep src.experiments.kgqa src/experiments/mixed_bias/configs/022_webqsp_magnitude_repro.jsonc
  //   python3 -m sweep.report src/experiments/mixed_bias/results/022_webqsp_magnitude_repro
  // ─────────────────────────────────────────────────────────────────────────

  "name": "022_webqsp_magnitude_repro",
  "results_dir": "src/experiments/mixed_bias/results",

  "execution": {
    "mode": "sbatch",
    "sbatch": {
      "granularity": "per_config",
      // 4 runs and ixh has 8 GPUs, so nothing here queues behind itself.
      "max_concurrent": 4,
      "partition": "frida",
      "account": "povejmo",
      // H100, as 018. The list form renders as `--gres gpu:1 --constraint
      // GPU_BRD:H100` rather than pinning the gres TYPE, which is the more
      // robust of the two.
      "gpus": ["H100"],
      "gpus_per_config": 1,
      "cpus": 8,
      // 128G, as 018 — at 64G four baseline runs were OOM-killed at ~3 h with
      // MaxRSS pinned exactly to the cgroup cap. Host RAM, unrelated to the arm.
      "mem": "128G",
      // 12 h, as 018. Note the cluster-wide 12 h maintenance starting ~2026-08-13
      // 11:20: these runs are 3-5 h and submitted well before it, so they clear
      // it, but anything submitted late on 2026-08-12 will not.
      "time": "12:00:00",
      "container": "/shared/workspace/povejmo/containers/transformers_deepspeed_latest.sqsh"
    }
  },

  // ── axes ──────────────────────────────────────────────────────────────────
  // Both seeds that produced a death in 018. Seed 1 is omitted: its magnitude
  // cell never trained a step (0 logged steps before the withdrawal), so it is
  // not a reproducer of anything.
  "seed": [0, 2],

  // The bundle form is 018's, so these objects are byte-comparable with 018's
  // arms 3 and 4 — each arm paired with the bias_lr it actually died at.
  "arm": [
    {"spd": false, "magnetic": false, "magnetic_linear": false, "magnetic_magnitude": true,  "magnetic_hybrid": false, "magnetic_m_collate": 64, "bias_self_node": true,  "bias_lr": 2e-2},
    {"spd": false, "magnetic": false, "magnetic_linear": false, "magnetic_magnitude": false, "magnetic_hybrid": true,  "magnetic_m_collate": 64, "bias_self_node": true,  "bias_lr": 5e-3}
  ],

  // ── magnitude-channel widths (MIXED_BIAS.md §2.5, §2.6) ───────────────────
  // 018's values unchanged. §5.8 altered the FORM of the channel, not its
  // widths, so changing these would confound the one comparison this run makes.
  "magnetic_magnitude_dim": 64,
  "magnetic_magnitude_repr_dim": 256,

  // ── 018_webqsp_mixed, verbatim below this line ────────────────────────────
  "question_node": "isolated",
  "mode": "train",
  "cvt_collapse": null,

  "dataset": "webqsp",
  "max_nodes": 512,
  "versions": 8,
  "n_max": 50,
  "data_seed": 42,
  "data_format_version": 3,

  "model_name": "meta-llama/Llama-3.2-1B",
  "rel_mode": "last_1",
  "num_epochs": 15,
  "batch_size": 2,
  "accumulation_steps": 4,
  "lr": 1e-4,
  "lora_r": 64,
  "lora_dropout": 0.15,
  "bias_weight_decay": 0.0,
  "k_hop": 0,
  "graph_attn_impl": "flex",
  "dtype": "bf16",
  "gradient_checkpointing": true,
  "num_workers": 4,

  "magnetic_shared": false,
  // max_spd stays at the built value even where spd is off: it is part of
  // data_config_key, so changing it would fork the dataset cache.
  "max_spd": 64,
  "magnetic_dim": 128,
  "magnetic_m": 128,
  "magnetic_q": 0.25,

  "eval_steps": 200,
  "gen_eval_samples": null,
  "gen_max_samples": null,
  "gen_max_new_tokens": 256,

  "wandb_project": "GraphLLM"
}
