{
  // ─────────────────────────────────────────────────────────────────────────
  // 041 — the no-soft-bias floor, measured in the same week on the same cluster.
  //
  // 040 reports every arm as a fraction of the bias headroom, and that fraction
  // needs a denominator measured under THIS recipe rather than borrowed. 010's
  // D arm (test F1 0.4580) used the identical recipe and is a legitimate
  // reference, but it predates the landmark plumbing and a same-week floor also
  // doubles as a regression check: if `none` lands far from 0.4580, something in
  // the collator/dataset changes touched a path it should not have.
  //
  // Split out of 040 rather than added as a seventh arm because bias_lr is one of
  // 040's axes and with no bias parameters it does nothing — folding it in would
  // buy two byte-identical duplicate runs.
  //
  // bias_self_node is false and must be: with no bias there is no diagonal to
  // keep, and the validator rejects the flag.
  //
  // 2 runs, ~2.8 GPU-h each.
  //
  //   python3 -m sweep src.experiments.kgqa src/experiments/bias_experiments/landmark/configs/041_webqsp_floor.jsonc
  // ─────────────────────────────────────────────────────────────────────────

  "name": "041_webqsp_floor",
  "results_dir": "src/experiments/bias_experiments/landmark/results",

  "execution": {
    "mode": "sbatch",
    "sbatch": {
      "granularity": "per_config",
      "max_concurrent": 2,
      "partition": "frida",
      "account": "povejmo",
      "gpus": ["B200", "B300"],
      "gpus_per_config": 1,
      "cpus": 8,
      "mem": "64G",
      "time": "12:00:00",
      "container": "/shared/workspace/povejmo/containers/transformers_deepspeed_latest.sqsh"
    }
  },

  "seed": [0, 1],

  "spd": false,
  "magnetic": false,
  "magnetic_linear": false,
  "landmark": false,
  "bias_self_node": false,
  "bias_lr": 5e-3,

  // ── 015_webqsp_selfnode's recipe, verbatim below this line ────────────────
  "question_node": "isolated",
  "mode": "train",
  "cvt_collapse": null,

  "dataset": "webqsp",
  "max_nodes": 512,
  "versions": 8,
  "n_max": 50,
  "data_seed": 42,
  "data_format_version": 3,

  "model_name": "meta-llama/Llama-3.2-1B",
  "rel_mode": "last_1",
  "num_epochs": 15,
  "batch_size": 2,
  "accumulation_steps": 4,
  "lr": 1e-4,
  "lora_r": 64,
  "lora_dropout": 0.15,
  "bias_weight_decay": 0.0,
  "k_hop": 0,
  "graph_attn_impl": "flex",
  "dtype": "bf16",
  "gradient_checkpointing": true,
  "num_workers": 4,

  "magnetic_shared": false,
  "max_spd": 64,
  "magnetic_dim": 128,
  "magnetic_m": 128,
  "magnetic_q": 0.25,

  "eval_steps": 200,
  "gen_eval_samples": null,
  "gen_max_samples": null,
  "gen_max_new_tokens": 256,

  "wandb_project": "GraphLLM"
}
