{
  // ─────────────────────────────────────────────────────────────────────────
  // 039 — a 3-run smoke test on the REAL data path, before 040's 26 jobs.
  //
  // The correctness gate proves the math on synthetic tensors. It does not prove
  // that the feature survives Arrow -> __getitem__ -> collator -> flex kernel on
  // a real 512-node WebQSP graph, which is where shape, dtype and bucketing
  // assumptions actually break. 26 crashed jobs cost a queue slot each and an
  // hour of wall clock to discover; this costs ~10 minutes.
  //
  // Three arms, one seed, max_steps 30, no generation eval:
  //   landmark k=32 (the largest slice — biggest tensors, most likely to break)
  //   landmark k=8  (exercises the PAD path: 3k=24 of a stored 96)
  //   magnetic_linear M=48 (the comparator's plumbing, unchanged but re-checked)
  //
  // What it is NOT: a quality measurement. 30 steps says nothing about F1 and no
  // number from this sweep may be quoted as a result.
  //
  //   python3 -m sweep src.experiments.kgqa src/experiments/bias_experiments/landmark/configs/039_webqsp_smoke.jsonc
  // ─────────────────────────────────────────────────────────────────────────

  "name": "039_webqsp_smoke",
  "results_dir": "src/experiments/bias_experiments/landmark/results",

  "execution": {
    "mode": "sbatch",
    "sbatch": {
      "granularity": "per_config",
      "max_concurrent": 3,
      "partition": "frida",
      "account": "povejmo",
      "gpus": ["B200", "B300"],
      "gpus_per_config": 1,
      "cpus": 8,
      "mem": "64G",
      "time": "01:00:00",
      "container": "/shared/workspace/povejmo/containers/transformers_deepspeed_latest.sqsh"
    }
  },

  "seed": 0,
  "max_steps": 30,
  "num_epochs": 1,
  "eval_steps": 20,
  "gen_max_samples": 8,

  "arm": [
    {"magnetic_linear": false, "landmark": true,  "magnetic_m_collate": 0,  "landmark_k_collate": 32, "bias_self_node": true},
    {"magnetic_linear": false, "landmark": true,  "magnetic_m_collate": 0,  "landmark_k_collate": 8,  "bias_self_node": true},
    {"magnetic_linear": true,  "landmark": false, "magnetic_m_collate": 48, "landmark_k_collate": 0,  "bias_self_node": true}
  ],

  "landmark_k": 32,
  "landmark_d_max": 8,
  "landmark_channels": 3,
  "bias_lr": 5e-3,

  "question_node": "isolated",
  "mode": "train",
  "cvt_collapse": null,

  "dataset": "webqsp",
  "max_nodes": 512,
  "versions": 8,
  "n_max": 50,
  "data_seed": 42,
  "data_format_version": 3,

  "model_name": "meta-llama/Llama-3.2-1B",
  "rel_mode": "last_1",
  "batch_size": 2,
  "accumulation_steps": 4,
  "lr": 1e-4,
  "lora_r": 64,
  "lora_dropout": 0.15,
  "bias_weight_decay": 0.0,
  "k_hop": 0,
  "graph_attn_impl": "flex",
  "dtype": "bf16",
  "gradient_checkpointing": true,
  "num_workers": 4,

  "spd": false,
  "magnetic": false,
  "magnetic_shared": false,
  "max_spd": 64,
  "magnetic_dim": 128,
  "magnetic_m": 128,
  "magnetic_q": 0.25,

  "gen_eval_samples": null,
  "gen_max_new_tokens": 256,

  "wandb_project": "GraphLLM"
}
