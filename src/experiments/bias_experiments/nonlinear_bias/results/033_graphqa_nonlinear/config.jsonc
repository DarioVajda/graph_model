{
  // ─────────────────────────────────────────────────────────────────────────
  // 033 — the non-linear pooled magnetic head (`magnetic_nonlinear`) on GraphQA.
  //
  // ── RESUBMISSION of 031, which is VOID ───────────────────────────────────
  // 031 completed all 36 runs and is discarded: the head's parameters were
  // initialised by an `nn.init.uniform_` applied AFTER registration, which
  // `from_pretrained` does not preserve for a bare nn.Parameter on a custom
  // module. W_attn came out exactly 0, collapsing the learned pool into the
  // uniform ablation — visible in 031 as attn/uniform pairs returning
  // byte-identical metrics at the no-bias floor (`shortest_path` 0.4700 vs the
  // known arm-0 floor of 0.469). The pool audit confirmed it before anything was
  // read, which is what that audit exists for. Fix pinned by
  // test_parameters_survive_from_pretrained; records under
  // results/031_graphqa_nonlinear_VOID. Nothing else about the grid changed.
  //
  // The DISCRIMINATING half of the experiment. WebQSP (030) has the statistical
  // power — its residual is ~3 pp against a seed sd of 0.19-0.89 pp — but GraphQA
  // is where the hypothesis is actually testable, because `mixed_bias` measured
  // the previous per-node arm's failure there with a shape:
  //
  //   arm 3 (`magnetic_magnitude`) recovered ~100% of the headroom on
  //   `node_degree` and `edge_count`, and sat at the floor on paths. Its README:
  //   "The channel is a *local* feature detector; it fails exactly where the
  //   answer is a path."
  //
  // That is a prediction about THIS arm. Re K(i,i) is local by construction; a
  // pooled row is not, and a path-reachability signature can live in one. So:
  //
  //   * if this arm also collapses on `shortest_path` while matching on
  //     `node_degree`, the failure is the pool, not the feature's locality, and
  //     `mixed_bias`'s "no per-node feature reaches it" is confirmed on its own
  //     terms rather than by extrapolation;
  //   * if it holds up on `shortest_path`, that is the one result that would
  //     make the residual look reachable, and it lands on the task the previous
  //     arm was worst at.
  //
  // `shortest_path` is therefore the task to read first, and it is the reason
  // this sweep exists alongside 030 rather than after it.
  //
  // ── read against 024 / 019 / 013 / 017, which are REUSED ─────────────────
  // Same recipe as 024 verbatim below the line: same tasks, same 3 seeds, same
  // 20 epochs, same question_node=isolated build, same bias_self_node=true.
  // GraphQA's cache is built at magnetic_m=0 on ~20-node graphs, so
  // magnetic_m_collate 64 and 128 are the same no-op and every arm shares one
  // build. magnetic_dim is not in the cache identity either, so 64 reuses it.
  //
  // TRAP, from mixed_bias/README.md: the `arm` LABEL in 013/017 runs.jsonl is
  // misaligned with the flags — run 0004, the no-bias cell, carries the label
  // `no-spd+rrwp+magnetic`. Key off the BOOLEANS. Keying off the label swaps the
  // GraphQA floor and ceiling and makes arm 0 look like it scores 0.97 without
  // seeing the graph. This sweep's own labels are correct (`mag-nonlinear` /
  // `mag-nonlinear-uniform`, pinned by a test) but the reused ones are not.
  //
  // ── grid ─────────────────────────────────────────────────────────────────
  // 2 arms x 2 bias_lr x 3 tasks x 3 seeds = 36 runs, ~40 min each = ~24 GPU-h.
  // Double 024's 18 because of the uniform-pool ablation, which is not optional:
  // it is what separates "the learned pool did the work" from "any non-linear
  // row summary would do", and on GraphQA it is cheap.
  //
  //   python3 -m src.experiments.nonlinear_bias.preflight
  //   python3 -m sweep src.experiments.graphqa src/experiments/nonlinear_bias/configs/033_graphqa_nonlinear.jsonc
  //   python3 -m sweep.report src/experiments/nonlinear_bias/results/033_graphqa_nonlinear
  // ─────────────────────────────────────────────────────────────────────────

  "name": "033_graphqa_nonlinear",
  "results_dir": "src/experiments/nonlinear_bias/results",

  "execution": {
    "mode": "sbatch",
    "sbatch": {
      "granularity": "per_config",
      // 36 short runs; 18 at a time is two waves of ~40 min. A100 is in the pool
      // because these are tiny (35-token sequences, v2-eager) and the Blackwell
      // nodes are better spent on 030's 5-hour runs.
      "max_concurrent": 18,
      "partition": "frida",
      "account": "povejmo",
      "gpus": ["A100", "H100", "B200", "B300"],
      "gpus_per_config": 1,
      "cpus": 8,
      "mem": "64G",
      "time": "00:40:00",
      "container": "/shared/workspace/povejmo/containers/transformers_deepspeed_latest.sqsh"
    }
  },

  "mode": "train",
  "task": ["node_degree", "shortest_path", "edge_count"],
  "seed": [42, 43, 44],

  "arm": [
    {"magnetic": false, "magnetic_linear": false, "magnetic_magnitude": false, "magnetic_hybrid": false, "magnetic_linear_v2": false, "magnetic_nonlinear": true, "magnetic_pool": "attn", "magnetic_m_collate": 64, "bias_self_node": true, "bias_lr": 5e-3},
    {"magnetic": false, "magnetic_linear": false, "magnetic_magnitude": false, "magnetic_hybrid": false, "magnetic_linear_v2": false, "magnetic_nonlinear": true, "magnetic_pool": "uniform", "magnetic_m_collate": 64, "bias_self_node": true, "bias_lr": 5e-3},
    {"magnetic": false, "magnetic_linear": false, "magnetic_magnitude": false, "magnetic_hybrid": false, "magnetic_linear_v2": false, "magnetic_nonlinear": true, "magnetic_pool": "attn", "magnetic_m_collate": 64, "bias_self_node": true, "bias_lr": 1e-3},
    {"magnetic": false, "magnetic_linear": false, "magnetic_magnitude": false, "magnetic_hybrid": false, "magnetic_linear_v2": false, "magnetic_nonlinear": true, "magnetic_pool": "uniform", "magnetic_m_collate": 64, "bias_self_node": true, "bias_lr": 1e-3}
  ],

  // See 030's header: 1x head_dim, against arm 2's 2x.
  "magnetic_struct_dim": 64,

  // ── 024_graphqa_linear_v2, verbatim below this line ──────────────────────
  "spd": false,
  "rrwp": false,
  "question_node": "isolated",
  "graph_type": "standard",

  "model_name": "meta-llama/Llama-3.2-1B",
  "impl": "v2-eager",
  "dtype": "fp32",
  "k_hop": 0,

  "lora": true,
  "lora_r": 16,
  "lora_dropout": 0.05,

  "num_epochs": 20,
  "batch_size": 4,
  "accumulation_steps": 8,
  "lr": 3e-5,
  "eval_steps": 20,
  "max_steps": -1,
  "num_workers": 4,

  "max_spd": 8,
  "max_rw_steps": 16,
  // 64, not 024's 32 — the shared trunk is paid once here, not per layer. Not in
  // the cache identity (uses_default_cache ignores it), so the build is shared.
  "magnetic_dim": 64,
  "magnetic_q": 0.25,
  "magnetic_m": 0,

  "wandb_project": "GraphLLM"
}
