{
  // ─────────────────────────────────────────────────────────────────────────
  // 035 — the same two arms as 032, on WebQSP, at bias_lr 2e-2.
  //
  // ── why this exists, and why 032 is not enough ───────────────────────────
  // 034 measured the LR trend on GraphQA's only discriminating task and it does
  // not plateau at 5e-3:
  //
  //     shortest_path, % of headroom:  1e-3 -> 43.4    5e-3 -> 72.2    2e-2 -> 101.0
  //
  // At 2e-2 the arm reaches the DENSE ceiling on paths (0.951 +/- 0.008) and beats
  // both arm 2 (95.6%) and arm 4 (96.9%). The pool audit tracks it exactly:
  // ||W_attn||_F is 3.3 at 1e-3, 4.2-9.8 at 5e-3 and 7-17 at 2e-2 against 3.27 at
  // init. So 032's 5e-3 cells are measuring an UNDER-TRAINED pool, and 032 alone
  // would report this arm below its own optimum on the primary endpoint.
  //
  // ── the objection this overrides, deliberately ───────────────────────────
  // The reference arms are WORSE at 2e-2 on WebQSP (arm 1 0.7198 -> 0.6297, arm 2
  // 0.6876 -> 0.6734), which is why 035 was initially argued against. That
  // reasoning was wrong: the fair comparison is each arm at ITS OWN optimum, and
  // this head's optimum is hotter than the baselines' because it carries ~4.6x
  // their parameters and starts from a zero gate. Reading arm N @2e-2 against
  // arm 2 @5e-3 is therefore the correct comparison, not a favourable one — arm 2
  // is being given its best cell and this arm its own.
  //
  // Both pool settings kept so the ablation carries over. The 1e-3 cells are NOT
  // repeated: 032 already runs them and 034 showed that end of the grid is cold.
  //
  // 2 arms x 3 seeds = 6 runs, ~4-5.3 GPU-h each = ~30 GPU-h.
  // ─────────────────────────────────────────────────────────────────────────
  "name": "035_webqsp_nonlinear_hot",
  "results_dir": "src/experiments/bias_experiments/nonlinear_bias/results",

  "execution": {
    "mode": "sbatch",
    "sbatch": {
      "granularity": "per_config",
      // The whole grid in one wave: 12 runs of ~5 h, so a second wave would cost
      // another 5 h of wall time for nothing. Blackwell alone carries 48 GPUs.
      "max_concurrent": 12,
      "partition": "frida",
      "account": "povejmo",
      // 021/023/025's pool. Absolute step times are not comparable across
      // brands; accuracy, the only thing read here, is unaffected.
      "gpus": ["H100", "B200", "B300"],
      "gpus_per_config": 1,
      "cpus": 8,
      // 128G, as 021/023/025 — at 64G four runs were OOM-killed at ~3 h with
      // MaxRSS pinned exactly to the cgroup cap. Host RAM, unrelated to the arm.
      "mem": "128G",
      "time": "12:00:00",
      "container": "/shared/workspace/povejmo/containers/transformers_deepspeed_latest.sqsh"
    }
  },

  // ── the grid (seed inside the bundle, 021/023/025's pattern) ─────────────
  // Every head flag written explicitly in every object, even where false, so the
  // resolved JSON is self-describing rather than relying on defaults.
  "arm": [
    {"spd": false, "magnetic": false, "magnetic_linear": false, "magnetic_magnitude": false, "magnetic_hybrid": false, "magnetic_linear_v2": false, "magnetic_nonlinear": true, "magnetic_pool": "attn", "magnetic_m_collate": 64, "bias_self_node": true, "bias_lr": 2e-2, "seed": 0},
    {"spd": false, "magnetic": false, "magnetic_linear": false, "magnetic_magnitude": false, "magnetic_hybrid": false, "magnetic_linear_v2": false, "magnetic_nonlinear": true, "magnetic_pool": "attn", "magnetic_m_collate": 64, "bias_self_node": true, "bias_lr": 2e-2, "seed": 1},
    {"spd": false, "magnetic": false, "magnetic_linear": false, "magnetic_magnitude": false, "magnetic_hybrid": false, "magnetic_linear_v2": false, "magnetic_nonlinear": true, "magnetic_pool": "attn", "magnetic_m_collate": 64, "bias_self_node": true, "bias_lr": 2e-2, "seed": 2},
    {"spd": false, "magnetic": false, "magnetic_linear": false, "magnetic_magnitude": false, "magnetic_hybrid": false, "magnetic_linear_v2": false, "magnetic_nonlinear": true, "magnetic_pool": "uniform", "magnetic_m_collate": 64, "bias_self_node": true, "bias_lr": 2e-2, "seed": 0},
    {"spd": false, "magnetic": false, "magnetic_linear": false, "magnetic_magnitude": false, "magnetic_hybrid": false, "magnetic_linear_v2": false, "magnetic_nonlinear": true, "magnetic_pool": "uniform", "magnetic_m_collate": 64, "bias_self_node": true, "bias_lr": 2e-2, "seed": 1},
    {"spd": false, "magnetic": false, "magnetic_linear": false, "magnetic_magnitude": false, "magnetic_hybrid": false, "magnetic_linear_v2": false, "magnetic_nonlinear": true, "magnetic_pool": "uniform", "magnetic_m_collate": 64, "bias_self_node": true, "bias_lr": 2e-2, "seed": 2}
  ],

  // ── head width ───────────────────────────────────────────────────────────
  // d_struct: what Q/K append to EVERY head, so unlike the internal widths of
  // the previous arms it is not free. 64 = 1x Llama-1B's head_dim, against arm
  // 2's 2M = 128 = 2x at the same M — this arm's one structural advantage on
  // cost. 32 is a follow-up axis if the arm lands well (NON_LINEAR_BIAS.md §4).
  "magnetic_struct_dim": 64,

  // ── 025_webqsp_linear_v2, verbatim below this line ───────────────────────
  "question_node": "isolated",
  "mode": "train",
  "cvt_collapse": null,

  "dataset": "webqsp",
  "max_nodes": 512,
  "versions": 8,
  "n_max": 50,
  "data_seed": 42,
  "data_format_version": 3,

  "model_name": "meta-llama/Llama-3.2-1B",
  "rel_mode": "last_1",
  "num_epochs": 15,
  "batch_size": 2,
  "accumulation_steps": 4,
  "lr": 1e-4,
  "lora_r": 64,
  "lora_dropout": 0.15,
  "bias_weight_decay": 0.0,
  "k_hop": 0,
  "graph_attn_impl": "flex",
  "dtype": "bf16",
  "gradient_checkpointing": true,
  "num_workers": 4,

  "magnetic_shared": false,
  // max_spd stays at the built value even where spd is off: it is part of
  // data_config_key, so changing it would fork the dataset cache.
  "max_spd": 64,
  // 64, not 025's 128 — see the header. E is shared across layers here, so this
  // width is paid once rather than per layer.
  "magnetic_dim": 64,
  "magnetic_m": 128,
  "magnetic_q": 0.25,

  "eval_steps": 200,
  "gen_eval_samples": null,
  "gen_max_samples": null,
  "gen_max_new_tokens": 256,

  "wandb_project": "GraphLLM"
}
