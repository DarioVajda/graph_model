{
  // ─────────────────────────────────────────────────────────────────────────
  // 018's WebQSP BASELINES, re-run at 128G after an out-of-memory loss.
  //
  // ── why this file exists ─────────────────────────────────────────────────
  // 018 asked for `mem: 64G`, copied verbatim from 015. That was never enough:
  // four baseline runs were OOM-killed at ~3 h with MaxRSS pinned to
  // 67 048 xxx K against the 67 108 864 K cgroup cap — they hit the ceiling
  // exactly — and the context sweep (020), which asks for 128G, peaked at
  // 70 GiB on the same code path. Host RAM, not GPU, and nothing to do with
  // which bias arm is active: the casualties were `magnetic` and
  // `magnetic_linear` runs.
  //
  // ── why only 9 cells ─────────────────────────────────────────────────────
  // 018's 12 baselines split three ways at the time of writing: 4 OOM-killed,
  // 5 cancelled while still pending (they would have repeated the failure), and
  // 3 still running under the old 64G. This file re-runs the first two groups
  // only. The 3 in flight are left alone; if any of them also OOMs, add its cell
  // here rather than re-running the whole grid.
  //
  //   in flight, NOT re-run here:  magnetic 2e-2 seed0
  //                                magnetic 5e-3 seed1
  //                                magnetic_linear 5e-3 seed1
  //
  // Because the 9 cells are not a clean cartesian product, `seed` rides INSIDE
  // each bundle rather than crossing as an axis — one object is one complete
  // run. That is the only structural difference from 018.
  //
  // ── arms 3 and 4 are deliberately absent ─────────────────────────────────
  // `magnetic_magnitude` and `magnetic_hybrid` were withdrawn from this study
  // after four divergences showed the parameterization is not trainable as
  // specified (MIXED_BIAS.md §5.7). These baselines are still worth having: they
  // are exactly what a future, normalised arm-3/4 sweep gets read against.
  //
  // 9 runs, ~4 h training each plus eval.
  //
  //   python3 -m sweep src.experiments.kgqa src/experiments/bias_experiments/mixed_bias/configs/021_webqsp_baselines.jsonc
  //   python3 -m sweep.report src/experiments/bias_experiments/mixed_bias/results/021_webqsp_baselines
  // ─────────────────────────────────────────────────────────────────────────

  "name": "021_webqsp_baselines",
  "results_dir": "src/experiments/bias_experiments/mixed_bias/results",

  "execution": {
    "mode": "sbatch",
    "sbatch": {
      "granularity": "per_config",
      "max_concurrent": 16,
      "partition": "frida",
      "account": "povejmo",
      // B200/B300, NOT the H100 that 018 used. Measured: identical work (15
      // epochs, eval_steps 200, same data) took 2:58-4:48 under 015 on
      // B200/B300, but 11:56+ on H100 — the run that produced that number timed
      // out at the 12 h limit without recording. B200's bf16 throughput is far
      // higher, so this is expected rather than anomalous; the mistake in 018 was
      // setting a walltime from B200-measured runtimes while assigning the work
      // to H100. At <5 h measured, the 12 h limit below is ~2.5x margin.
      "gpus": ["B200", "B300"],
      "gpus_per_config": 1,
      "cpus": 8,
      // THE FIX. See the header: 64G was the cause of the loss this file repairs.
      "mem": "128G",
      "time": "12:00:00",
      "container": "/shared/workspace/povejmo/containers/transformers_deepspeed_latest.sqsh"
    }
  },

  // ── the 9 missing cells ───────────────────────────────────────────────────
  // arm 1 = magnetic (masked, the ceiling); arm 2 = magnetic_linear (unmasked).
  "arm": [
    {"spd": false, "magnetic": true,  "magnetic_linear": false, "magnetic_m_collate": 64, "bias_self_node": false, "bias_lr": 5e-3, "seed": 0},
    {"spd": false, "magnetic": true,  "magnetic_linear": false, "magnetic_m_collate": 64, "bias_self_node": false, "bias_lr": 5e-3, "seed": 2},
    {"spd": false, "magnetic": true,  "magnetic_linear": false, "magnetic_m_collate": 64, "bias_self_node": false, "bias_lr": 2e-2, "seed": 1},
    {"spd": false, "magnetic": true,  "magnetic_linear": false, "magnetic_m_collate": 64, "bias_self_node": false, "bias_lr": 2e-2, "seed": 2},

    {"spd": false, "magnetic": false, "magnetic_linear": true,  "magnetic_m_collate": 64, "bias_self_node": true,  "bias_lr": 5e-3, "seed": 0},
    {"spd": false, "magnetic": false, "magnetic_linear": true,  "magnetic_m_collate": 64, "bias_self_node": true,  "bias_lr": 5e-3, "seed": 2},
    {"spd": false, "magnetic": false, "magnetic_linear": true,  "magnetic_m_collate": 64, "bias_self_node": true,  "bias_lr": 2e-2, "seed": 0},
    {"spd": false, "magnetic": false, "magnetic_linear": true,  "magnetic_m_collate": 64, "bias_self_node": true,  "bias_lr": 2e-2, "seed": 1},
    {"spd": false, "magnetic": false, "magnetic_linear": true,  "magnetic_m_collate": 64, "bias_self_node": true,  "bias_lr": 2e-2, "seed": 2},

    // The three cells 018 still had IN FLIGHT when this file was first written.
    // All three have since died without recording — one TIMEOUT at the 12 h H100
    // limit, two cancelled once it was clear they could not finish under 64G — so
    // they belong here after all. With these, this sweep is the COMPLETE WebQSP
    // baseline grid (2 arms x 2 bias_lr x 3 seeds = 12) in one directory, which
    // is what `sweep.report`'s median-seed rule needs; splitting it across two
    // sweeps would mean merging runs.jsonl by hand.
    {"spd": false, "magnetic": true,  "magnetic_linear": false, "magnetic_m_collate": 64, "bias_self_node": false, "bias_lr": 2e-2, "seed": 0},
    {"spd": false, "magnetic": true,  "magnetic_linear": false, "magnetic_m_collate": 64, "bias_self_node": false, "bias_lr": 5e-3, "seed": 1},
    {"spd": false, "magnetic": false, "magnetic_linear": true,  "magnetic_m_collate": 64, "bias_self_node": true,  "bias_lr": 5e-3, "seed": 1}
  ],

  // ── 018_webqsp_mixed, verbatim below this line ────────────────────────────
  "question_node": "isolated",
  "mode": "train",
  "cvt_collapse": null,

  "dataset": "webqsp",
  "max_nodes": 512,
  "versions": 8,
  "n_max": 50,
  "data_seed": 42,
  "data_format_version": 3,

  "model_name": "meta-llama/Llama-3.2-1B",
  "rel_mode": "last_1",
  "num_epochs": 15,
  "batch_size": 2,
  "accumulation_steps": 4,
  "lr": 1e-4,
  "lora_r": 64,
  "lora_dropout": 0.15,
  "bias_weight_decay": 0.0,
  "k_hop": 0,
  "graph_attn_impl": "flex",
  "dtype": "bf16",
  "gradient_checkpointing": true,
  "num_workers": 4,

  "magnetic_shared": false,
  "max_spd": 64,
  "magnetic_dim": 128,
  "magnetic_m": 128,
  "magnetic_q": 0.25,

  "eval_steps": 200,
  "gen_eval_samples": null,
  "gen_max_samples": null,
  "gen_max_new_tokens": 256,

  "wandb_project": "GraphLLM"
}
