{
  // ─────────────────────────────────────────────────────────────────────────
  // 024 — arm v2 (`magnetic_linear_v2`) on GraphQA.
  //
  // The gated linear head: arm 2's bilinear phase channel with its eigenvalue
  // features scaled by a bounded per-node gate read off the spectral
  // self-energy. It is arm 2 EXACTLY at
  // initialisation — the gate is 1 + tanh(0) = 1, asserted bit-for-bit in
  // tests/models/test_gated_linear_magnetic_bias.py — so everything this sweep
  // measures is what the gate learns to do on top of arm 2.
  //
  // ── why GraphQA first ────────────────────────────────────────────────────
  // Not preference; the maintenance window. The cluster-wide reservation opens
  // 2026-08-13 13:00 and runs 12 h, and WebQSP is a 4-5 h job that cannot fit
  // ahead of it at any GPU count worth trusting (see the README). GraphQA runs
  // are 11-27 min measured (sacct, 019), so a complete 3-task x 3-seed grid fits
  // in the remaining window with margin. The `time` below is set from THAT
  // window, not from the workload: at 04:00:00 (019's budget) Slurm would refuse
  // to start the array at all, because it cannot fit a 4 h job before a
  // reservation 50 min away. This is the whole reason the number is 00:40:00.
  //
  // GraphQA is also where the gate has its strongest prior. S_i = Re K(i,i) is a
  // centrality-like per-node quantity and `node_degree` is literally that, so a
  // per-node modulation of the pairwise channel has something to key on. 019's
  // header made the same argument for arm 3, which spends the same feature
  // ADDITIVELY; this arm spends it multiplicatively, inside the spectral sum.
  //
  // ── controls are REUSED, as in 019 ───────────────────────────────────────
  // Arms 0/1/2 come from 013 D (floors: node_degree 0.086, shortest_path 0.470,
  // edge_count 0.026), 017 B (masked) and 017 C (unmasked). The comparison that
  // matters is v2 vs 017 C: same mask setting (bias_self_node true), same M,
  // same recipe, and v2 reduces to exactly that arm when the gate does not move.
  // They survive M=64 because 013/017 build at magnetic_m: 0 on ~20-node graphs,
  // so min(N, 64) = min(N, 128) = N and the truncation is a no-op either way.
  //
  // ── bias_lr ──────────────────────────────────────────────────────────────
  // Both LRs, 5e-3 FIRST in the bundle so the array's low-index tasks are the
  // priority cells. The gate adds a parameter block whose count resembles
  // neither incumbent, so it is read at its own best (MIXED_BIAS.md §5.2); 5e-3
  // leads because it is where arms 2 and 4 were read on WebQSP and where the
  // reused GraphQA controls sit.
  //
  // 1 arm x 2 bias_lr x 3 tasks x 3 seeds = 18 runs, ~11-27 min each = ~5 GPU-h.
  //
  //   python3 -m sweep src.experiments.graphqa src/experiments/bias_experiments/mixed_bias/configs/024_graphqa_linear_v2.jsonc
  //   python3 -m sweep.report src/experiments/bias_experiments/mixed_bias/results/024_graphqa_linear_v2
  // ─────────────────────────────────────────────────────────────────────────

  "name": "024_graphqa_linear_v2",
  "results_dir": "src/experiments/bias_experiments/mixed_bias/results",

  "execution": {
    "mode": "sbatch",
    "sbatch": {
      "granularity": "per_config",
      "max_concurrent": 18,
      "partition": "frida",
      "account": "povejmo",
      // Every brand this recipe is known to run on — 019 used exactly this list.
      // Widening the pool matters more than usual here: the array has to DRAIN
      // inside the window, so it wants every idle GPU it can backfill into, and
      // at submission ixb4-8 (40 Blackwell GPUs) plus ixh (8 H100) are free.
      "gpus": ["A100", "H100", "B200", "B300"],
      "gpus_per_config": 1,
      "cpus": 8,
      "mem": "64G",
      // Sized to the maintenance window, NOT to the workload (see the header).
      // 019's measured max was 26:53, so 40 min carries a comfortable margin
      // while still fitting ahead of the 13:00 reservation. A run that somehow
      // exceeds it is killed rather than delaying the whole array past the
      // window — which is the right trade when the alternative is the array not
      // starting at all.
      "time": "00:40:00",
      "container": "/shared/workspace/povejmo/containers/transformers_deepspeed_latest.sqsh"
    }
  },

  "mode": "train",

  // ── axes ──────────────────────────────────────────────────────────────────
  "task": ["node_degree", "shortest_path", "edge_count"],
  "seed": [42, 43, 44],

  // A BUNDLE, 019's pattern: head flag, mask and LR vary together. Unmasked
  // (bias_self_node true) because this arm is a bilinear form — an inner product
  // yields <q_i, k_i> and cannot be forced to zero, so unmasked is the only
  // configuration a factorized backbone can run (MIXED_BIAS.md §5.1). It is also
  // what 017 C ran, which is what makes that the comparable control.
  //
  // Every head flag is written out explicitly even where false, so the resolved
  // JSON is self-describing rather than depending on defaults.
  "arm": [
    {"magnetic": false, "magnetic_linear": false, "magnetic_magnitude": false, "magnetic_hybrid": false, "magnetic_linear_v2": true, "magnetic_m_collate": 64, "bias_self_node": true, "bias_lr": 5e-3},
    {"magnetic": false, "magnetic_linear": false, "magnetic_magnitude": false, "magnetic_hybrid": false, "magnetic_linear_v2": true, "magnetic_m_collate": 64, "bias_self_node": true, "bias_lr": 2e-2}
  ],

  // ── gate width ───────────────────────────────────────────────────────────
  // INTERNAL to the gate MLP: evaluated once per node per forward and never seen
  // by attention, so unlike magnetic_magnitude_dim it costs O(N) and is free.
  // The gate's OUTPUT width is magnetic_dim by construction and is not a knob.
  // 256 matches magnetic_magnitude_repr_dim so the two non-linear arms carry
  // comparable per-node capacity. Note magnetic_dim is 32 here (not 128 as on
  // WebQSP), so the gate MLP is 32 -> 256 -> 32.
  "magnetic_gate_repr_dim": 256,

  // The two pairwise biases the factorization cannot represent (013's header).
  // spd=false is REQUIRED rather than preferred: bias_self_node does not cover
  // SPDBias (its lookup has no self-distance row) and validate() rejects the
  // combination instead of half-applying the flag.
  "spd": false,
  "rrwp": false,

  // ── 019_graphqa_mixed, verbatim below this line ───────────────────────────
  "question_node": "isolated",
  "graph_type": "standard",

  "model_name": "meta-llama/Llama-3.2-1B",
  "impl": "v2-eager",
  "dtype": "fp32",
  "k_hop": 0,
  "lora": true,
  "lora_r": 16,
  "lora_dropout": 0.05,
  "num_epochs": 20,
  "batch_size": 4,
  "accumulation_steps": 8,
  "lr": 3e-5,
  "eval_steps": 20,
  "max_steps": -1,
  "num_workers": 4,
  // Kept at the built values even where the feature is off: they are part of the
  // data cache identity, so changing them would fork the cache.
  "max_spd": 8,
  "max_rw_steps": 16,
  "magnetic_dim": 32,
  "magnetic_q": 0.25,
  "magnetic_m": 0,

  "wandb_project": "GraphLLM"
}
