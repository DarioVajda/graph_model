{
  // ─────────────────────────────────────────────────────────────────────────
  // Phase 2 follow-up — does keeping the intra-node diagonal change anything?
  //
  // LINEAR_BIAS.md §7.3 flagged this and §6 never ran it. `_finalize` zeroes
  // b_ii, and because the bias is NODE-level and lifted to tokens by
  // expand_node_to_token_bias, that zeroing removes the structural bias from
  // EVERY token pair inside one node — not merely a token attending to itself.
  // On WebQSP, whose entity names are multi-token, that is a lot of pairs.
  //
  // It matters for two independent reasons:
  //
  //   1. The factorization CANNOT express the zeroing. An inner product gives
  //      <q_i, k_i> and there is no way to subtract it, so the deferred backbone
  //      of §7 would necessarily run unmasked. Every number in 010 was measured
  //      masked. Without this sweep the eventual §7 delta is confounded with a
  //      change nobody priced.
  //   2. The diagonal is not noise. At i=j the imaginary part vanishes
  //      identically and K(i,i) = sum_l |V_il|^2 phi_l — a real per-node spectral
  //      self-energy. Zeroing it discards a node-level feature the model could
  //      otherwise use.
  //
  // ── arms: the mask crossed with the head ─────────────────────────────────
  // B and C are BOTH run at both mask settings. Comparing an unmasked C against
  // 010's masked B would confound the two changes, and running only C would not
  // say whether the diagonal is worth anything to the MLP head — which is the
  // control that separates "the factorization gets a free feature back" from
  // "this bias likes a diagonal".
  //
  //   B  magnetic,        mask on   <- exact rerun of 010's headline B cell
  //   B  magnetic,        mask off
  //   C  magnetic_linear, mask on   <- exact rerun of 010's headline C cell
  //   C  magnetic_linear, mask off  <- the hypothesis
  //
  // The two mask-on arms are deliberate duplicates of 010. They cost 6 runs and
  // buy two things: a within-sweep control measured on the same cluster in the
  // same week, and a REGRESSION CHECK on the refactor — bias_self_node made
  // _finalize an instance method, and if the masked path still lands on 010's
  // 0.7190 / 0.6699 then the default behaviour is provably unchanged.
  //
  // D (no soft bias) is NOT re-run: with no bias module there is no diagonal to
  // keep, so the mask cannot move it. 010's floor (test F1 0.4580, same recipe,
  // same data, 3 seeds) is the denominator for the headroom fractions.
  //
  // ── M ────────────────────────────────────────────────────────────────────
  // Pinned at 128 for every arm — 010's headline cell and the one where B and C
  // are both measured. C at M=64 scored marginally higher (0.6717 vs 0.6699,
  // inside seed noise), but mixing M values across the mask comparison would put
  // two variables in one contrast. M is 011/013's question, not this one.
  //
  // 4 arms x 3 seeds = 12 runs, ~2.8 GPU-h each (sacct, 010) = ~34 GPU-h.
  //
  //   python3 -m sweep src.experiments.kgqa src/experiments/linear_bias/configs/015_webqsp_selfnode.jsonc
  //   python3 -m sweep.report src/experiments/linear_bias/results/015_webqsp_selfnode
  // ─────────────────────────────────────────────────────────────────────────

  "name": "015_webqsp_selfnode",
  "results_dir": "src/experiments/linear_bias/results",

  "execution": {
    "mode": "sbatch",
    "sbatch": {
      "granularity": "per_config",
      "max_concurrent": 12,
      "partition": "frida",
      "account": "povejmo",
      // B200 or B300, nothing else. A list becomes a generic gres count plus a
      // GPU_BRD feature constraint, since Slurm gres cannot express an OR.
      "gpus": ["B200", "B300"],
      "gpus_per_config": 1,
      "cpus": 8,
      "mem": "64G",
      "time": "24:00:00",
      "container": "/shared/workspace/povejmo/containers/transformers_deepspeed_latest.sqsh"
    }
  },

  // ── axes ──────────────────────────────────────────────────────────────────
  "seed": [0, 1, 2],

  // A BUNDLE: each object is one coherent arm. bias_self_node rides inside it
  // rather than crossing, so no arm can be generated with the flag set and no
  // bias to apply it to (validate() rejects that, and a crossed axis would hit
  // it).
  "arm": [
    {"spd": false, "magnetic": true,  "magnetic_linear": false, "magnetic_m_collate": 128, "bias_self_node": false},
    {"spd": false, "magnetic": true,  "magnetic_linear": false, "magnetic_m_collate": 128, "bias_self_node": true},
    {"spd": false, "magnetic": false, "magnetic_linear": true,  "magnetic_m_collate": 128, "bias_self_node": false},
    {"spd": false, "magnetic": false, "magnetic_linear": true,  "magnetic_m_collate": 128, "bias_self_node": true}
  ],

  // ── 010_webqsp_linear, verbatim below this line ───────────────────────────
  "question_node": "isolated",
  "mode": "train",
  "cvt_collapse": null,

  "dataset": "webqsp",
  "max_nodes": 512,
  "versions": 8,
  "n_max": 50,
  "data_seed": 42,
  "data_format_version": 3,

  "model_name": "meta-llama/Llama-3.2-1B",
  "rel_mode": "last_1",
  "num_epochs": 15,
  "batch_size": 2,
  "accumulation_steps": 4,
  "lr": 1e-4,
  "bias_lr": 5e-3,
  "lora_r": 64,
  "lora_dropout": 0.15,
  "bias_weight_decay": 0.0,
  "k_hop": 0,
  "graph_attn_impl": "flex",
  "dtype": "bf16",
  "gradient_checkpointing": true,
  "num_workers": 4,

  "magnetic_shared": false,
  // max_spd stays at the built value even where spd is off: it is part of
  // data_config_key, so changing it would fork the dataset cache.
  "max_spd": 64,
  "magnetic_dim": 128,
  "magnetic_m": 128,
  "magnetic_q": 0.25,

  "eval_steps": 200,
  "gen_eval_samples": null,
  "gen_max_samples": null,
  "gen_max_new_tokens": 256,

  "wandb_project": "GraphLLM"
}
