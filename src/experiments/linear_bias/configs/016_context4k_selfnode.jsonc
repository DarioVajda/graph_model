{
  // ─────────────────────────────────────────────────────────────────────────
  // 015's question on the context task: does keeping b_ii change the linear
  // head's behaviour? Rationale for the flag itself: see 015's header.
  //
  // ── why this config looks like 012 and not like 011 ──────────────────────
  // 011 ran the M-grid at bias_lr 5e-3 and read as "linearization destroys the
  // context task" (C 0.08 vs B 0.995). 012 showed that was largely an
  // OPTIMIZATION artifact: 5e-3 was tuned for the MLP head's 36 864 bias
  // parameters, the linear head has 8 192 and no hidden nonlinearity, and at
  // bias_lr 2e-2 with 4 epochs C goes 0.09 -> 0.59. So the best known masked
  // linear recipe on this task is 012's, not 011's, and that is what is carried
  // over here: 4 epochs, M=128, bias_lr 2e-2.
  //
  // ── why bias_lr is still an axis ─────────────────────────────────────────
  // The campaign's own lesson (README §6.5) is that a shared LR prices
  // optimization rather than math. Keeping b_ii ADDS a term to every intra-node
  // logit — and a systematically signed one, since K(i,i) = sum_l |V_il|^2 phi_l
  // is a weighted sum of non-negative squares rather than a signed inner product
  // — so there is no reason to assume the masked arm's optimum LR transfers.
  // Sweeping {5e-3, 2e-2} on BOTH mask settings lets each arm be read at its own
  // best, which is the only way this comparison stays about the diagonal.
  //
  // 5e-2 is dropped: 012 measured it as divergent (0.070 median), so it is a
  // known-dead point and not worth 6 more runs.
  //
  // ── arms ─────────────────────────────────────────────────────────────────
  //   C  magnetic_linear, mask on,  bias_lr 5e-3   012's control, reproduced
  //   C  magnetic_linear, mask on,  bias_lr 2e-2   012's best masked cell (0.590)
  //   C  magnetic_linear, mask off, bias_lr 5e-3
  //   C  magnetic_linear, mask off, bias_lr 2e-2   the hypothesis
  //
  // B is NOT run here, unlike in 015. On context B sits at 0.995 after 2 epochs
  // — there is no headroom left for a diagonal to improve, so a B mask
  // comparison would measure a ceiling, not an effect. 011's B (0.995) and 012's
  // D floor (0.035, same 4 epochs) supply both ends of the scale.
  //
  // Read it against 012's masked medians: C@5e-3 0.090, C@2e-2 0.590. The two
  // mask-on arms here are the same cells and should land there; they double as
  // the regression check that making _finalize an instance method left the
  // default path unchanged.
  //
  // Expect high seed variance on the 2e-2 arms — 012 saw 0.435 / 0.590 / 0.775,
  // which is what a transition caught mid-flight looks like. A median that moves
  // less than that spread is not a result.
  //
  // 4 arms x 3 seeds = 12 runs, ~7.2 GPU-h each (012 measured 3.6 h for 2
  // epochs) = ~86 GPU-h.
  //
  //   python3 -m sweep src.experiments.context src/experiments/linear_bias/configs/016_context4k_selfnode.jsonc
  //   python3 -m sweep.report src/experiments/linear_bias/results/016_context4k_selfnode
  // ─────────────────────────────────────────────────────────────────────────

  "name": "016_context4k_selfnode",
  "results_dir": "src/experiments/linear_bias/results",

  "execution": {
    "mode": "sbatch",
    "sbatch": {
      "granularity": "per_config",
      "max_concurrent": 12,
      "partition": "frida",
      "account": "povejmo",
      // B200 or B300, nothing else.
      "gpus": ["B200", "B300"],
      "gpus_per_config": 1,
      "cpus": 16,
      "mem": "128G",
      // 012's runs were sized at 4 epochs / ~7.2 h; 12 h leaves room.
      "time": "12:00:00",
      "container": "/shared/workspace/povejmo/containers/transformers_deepspeed_latest.sqsh"
    }
  },

  "mode": "train",

  // ── axes ──────────────────────────────────────────────────────────────────
  "seed": [0, 1, 2],

  // bias_lr rides inside the bundle for the same reason it did in 012: it is not
  // independent of the arm, and crossing it would generate combinations that are
  // not the comparison being made.
  "arm": [
    {"spd": false, "magnetic": false, "magnetic_linear": true, "magnetic_m_collate": 128, "bias_self_node": false, "bias_lr": 5e-3},
    {"spd": false, "magnetic": false, "magnetic_linear": true, "magnetic_m_collate": 128, "bias_self_node": false, "bias_lr": 2e-2},
    {"spd": false, "magnetic": false, "magnetic_linear": true, "magnetic_m_collate": 128, "bias_self_node": true,  "bias_lr": 5e-3},
    {"spd": false, "magnetic": false, "magnetic_linear": true, "magnetic_m_collate": 128, "bias_self_node": true,  "bias_lr": 2e-2}
  ],

  // ── 012_context4k_linear_long verbatim below this line ────────────────────
  "hop_counts": "1,2,3,4",
  "fan_out": 2,

  "node_counts": "16,32,64,128",
  "token_counts": "64,128,256,512",
  "max_train_len": 4096,
  "n_train": 16000,
  "n_dev": 200,
  "n_test": 200,
  "code_len": 3,
  "id_pool": 4096,
  "data_seed": 42,

  "model_name": "meta-llama/Llama-3.2-1B",
  "lora_r": 64,
  "lora_dropout": 0.15,
  "dtype": "bf16",
  "max_spd": 8,
  "rrwp": false,
  "magnetic_dim": 128,
  "magnetic_m": 128,
  "magnetic_q": 0.25,
  "k_hop": 0,
  "graph_attn_impl": "flex",
  "compile_mode": "default",

  "num_epochs": 4,
  "batch_size": 1,
  "accumulation_steps": 8,
  "lr": 1e-4,
  "gradient_checkpointing": true,
  "num_workers": 4,
  "eval_steps": 500,

  "wandb_project": "GraphLLM"
}
