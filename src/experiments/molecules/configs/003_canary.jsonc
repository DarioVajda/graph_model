{
  // ─────────────────────────────────────────────────────────────────────────
  // 003 — the canary 001 could not be. Same three arms, a real budget.
  //
  // WHY THIS EXISTS. 001 ran 30 optimizer steps and reported graph-arm accuracy
  // of exactly 0.000 against flat's 0.540, with graph loss starting at 13.48 —
  // *above* uniform over Llama's 128k vocab (ln 128256 = 11.76). That looks like
  // a defect, and three checks were run before concluding otherwise:
  //
  //   1. The data is correct. The prompt node tokenizes to
  //      ["\n", "A", ":", " No"], labels are [-100, -100, -100, 2360], and the
  //      collator places them at [prefix_len : prefix_len + prompt_len] and
  //      validates that length against the prompt node. Verified on the built
  //      artifact for both arms.
  //   2. The comparison to `probes` (initial loss ~5.1, accuracy at chance from
  //      step 0) is NOT the right one: probes puts the question INSIDE the
  //      prompt node, so its answer position follows a complete question in
  //      contiguous positions.
  //   3. The right comparison is graphqa's `question_node: isolated` arm, whose
  //      `ANSWER_PREFIX = "A:"` gives a prompt node of "A: <answer>" —
  //      structurally identical to ours. That arm is worth +2.1pp on GraphQA, so
  //      the construction is proven, not broken.
  //
  // So the 13.48 start is the base model having no prior for emitting a label
  // token after a bare 4-token prompt node, and 0.000 at 30 steps is a model
  // that has not yet learned the output format at all. Loss fell 13.48 -> 6.85
  // in those 30 steps, which is fast. `feedback-dont-call-floors-early`: extend
  // the budget before theorising about architecture.
  //
  // WHAT WOULD FALSIFY THE BENIGN READING: if the graph arm is still at ~0.000
  // accuracy after 1250 steps while its loss plateaus above ~2, the construction
  // IS wrong and the next suspect is the isolated question node — test it by
  // rebuilding with the question inside the prompt node (probes' layout).
  //
  // One seed: this is a diagnostic, not a measurement. No number from it may be
  // quoted as a result either.
  //
  //   python3 -m sweep src.experiments.molecules src/experiments/molecules/configs/003_canary.jsonc
  // ─────────────────────────────────────────────────────────────────────────

  "name": "003_canary",
  "results_dir": "src/experiments/molecules/results",

  "execution": {
    "mode": "sbatch",
    "sbatch": {
      "granularity": "per_config",
      "max_concurrent": 3,
      "partition": "frida",
      "account": "povejmo",
      "gpus": ["B200", "B300"],
      "gpus_per_config": 1,
      "cpus": 8,
      "mem": "64G",
      "time": "03:00:00",
      "container": "/shared/workspace/povejmo/containers/transformers_deepspeed_latest.sqsh"
    }
  },

  // ══ RETIRED 2026-08-29 — DO NOT RE-RUN, IT WILL FAIL ══════════════════════
  // This config asked its question and got an answer: nothing was broken (§3.2.3).
  // `node_position_mode` has since been UNWIRED from this experiment entirely, so
  // the two arms below that set it no longer parse. Kept as the record of what
  // the canary asked, not as a runnable config; what actually ran is frozen in
  // `results/003_canary/config.jsonc` and the numbers are in PLAN.md §3.2.3.
  // ══════════════════════════════════════════════════════════════════════════
  //
  // Four arms that separate the two candidate causes of the 0.000 (§3.2.2).
  // The CPU diagnostic showed the graph arm's top-5 at the answer position was
  // [' ring', ' deg', ' carbon', '9', '1'] — it is continuing the atom
  // description — while the flat arm's was [' True', ' ', ' yes', ' Yes',
  // ' true']. Two things could cause that, and they are separable:
  //
  //   POSITIONAL — under "reset" the prompt node's "\nA:" sits at positions
  //     0,1,2, the same positions that begin every atom node, so the model
  //     cannot tell the answer anchor from another node start. Verified
  //     directly: reset gives prompt positions [0,1,2,3] against a max prefix
  //     position of 10; spd_depth gives [363,364,365,366] against 362.
  //   LEXICAL — the prompt node carries no question, so there is no textual cue
  //     that an answer is due. `question_node: "off"` puts the question back
  //     inside the prompt node (the layout `probes` uses, which starts at loss
  //     ~5.1 and chance accuracy rather than 13.48 and zero).
  //
  // Running both fixes separately says which mechanism is responsible. If
  // spd_depth alone fixes it, that is a positional finding that generalises to
  // every text-rich GTLM domain, not a molecules workaround.
  "arm_fix": [
    { "arm": "graph", "bias": "spd+magnetic", "node_position_mode": "reset",     "question_node": "isolated" },
    { "arm": "graph", "bias": "spd+magnetic", "node_position_mode": "spd_depth", "question_node": "isolated" },
    { "arm": "graph", "bias": "spd+magnetic", "node_position_mode": "reset",     "question_node": "off" },
    { "arm": "flat",  "bias": "none",         "node_position_mode": "reset",     "question_node": "isolated" }
  ],

  "task": "ring_membership",
  "encoding": "rich_levi",
  // A COMMA STRING, not a JSON list. `pool` is a list-VALUED parameter, and the
  // sweep runner cannot tell that from a sweep AXIS — `["bace", "bbbp"]` silently
  // expands into two runs of one corpus each instead of one run over both.
  // (001_smoke escaped this only because its list had a single element.) The
  // `_str_list` parser splits the string back out.
  "pool": "bace,bbbp",
  "seed": 0,

  "train_size": 4000,
  "val_size": 500,
  "test_size": 1000,
  "data_seed": 0,

  // 4000 / (4 x 8) = 125 steps per epoch; 10 epochs = 1250 steps, ~40x the smoke.
  "num_epochs": 10,
  "eval_steps": 100,
  "batch_size": 4,
  "accumulation_steps": 8,
  "lr": 1e-5,
  "bias_lr": 1e-3,
  "lora": true,
  "lora_r": 8,
  "num_workers": 4,

  // 001 measured flex faster than eager with the bias on (1493 vs 2177 ms/step)
  // and lower peak memory (20.8 vs 26.1 GB); at 1250 steps the autotune pays for
  // itself, unlike at 30.
  "impl": "v2-flex",
  "flex_compile_mode": "max-autotune-no-cudagraphs"
}
