{
  // ─────────────────────────────────────────────────────────────────────────
  // 011 — the two holes M2 left open, both named in PLAN.md §8 as outstanding.
  // Seven runs. Independent of Tier B, so it runs alongside 010/001.
  //
  // HOLE 1 — a second seed on the `longest_chain` ablation (runs 1-4).
  // §3.2.8 ends: "Every cell here is one seed. 5.2 sigma bounds SAMPLING error
  // only and says nothing about seed-to-seed training variance; a second seed on
  // the four `longest_chain` cells is the last thing standing between this and a
  // claim fit for `src/generalist/PLAN.md`." This is that seed. The four cells are
  // §3.2.8's table: graph x {none, spd, spd+magnetic} and the flat twin.
  //
  //   `seed` moves 0 -> 1; `data_seed` stays 0 ON PURPOSE. The question is
  //   training variance at a fixed dataset, which is what the sigma in §3.2.8 does
  //   not cover. Changing both would confound the two sources.
  //
  //   What would change the claim: if the `spd` - `none` gap (+0.045 at seed 0)
  //   comes back materially smaller at seed 1, then "the bias buys the win" is a
  //   one-seed artifact and §3.2.8 must be softened before it reaches the trunk
  //   plan. Report both seeds either way — not the better one.
  //
  // HOLE 2 — gate A2's negative control, which has never been run (runs 5-7).
  // §1 declares `stereo_assigned` the designed-in loss and says: "Run
  // `stereo_assigned` under both `off` and `on`; the GAP between them is the
  // result." Only `on` was ever run, and at the stale recipe it saturated in both
  // arms (0.997 / 0.996), so the control never fired — the suite currently has no
  // working leakage detector (PLAN.md §9).
  //
  //   `stereo_tags: off` removes the parity tag from the atom text, which is the
  //   ONLY channel by which chirality reaches the graph. The R/S answer is then
  //   provably not in the input, so:
  //
  //     graph, tags off  -> should sit at the 0.715 base rate. Above it means
  //                         something LEAKS, and PLAN.md §2.5 gate A2 says to find
  //                         it before reading any other row of the suite.
  //     graph, tags on   -> should be high. The gap is the measurement.
  //     flat             -> unaffected by `stereo_tags` (`flat_serialize` does not
  //                         read it); it is here because 004's 0.996 was measured
  //                         at the STALE recipe and §3.2.9 disclosure 3 showed the
  //                         tuned recipe moves the flat arm 3-6 points.
  //
  //   The labels are identical across all three: the CIP answer comes from the
  //   source molecule's own @/@@ tags, not from the node text, so `stereo_tags`
  //   changes the INPUT only. That is what makes the contrast a clean test of
  //   information flow rather than of two different tasks.
  //
  // RECIPE. 006/007's tuned recipe verbatim (`lr 3e-5, bias_lr 5e-3, lora_r 16`,
  // 5000 steps), so runs 1-4 are directly comparable to §3.2.8's table and runs
  // 5-7 are comparable to §3.2.9's. NOT 008's `bias_lr 1e-2`, which §3.2.9
  // measured as equivalent-not-better.
  //
  // HARDWARE. Same profile as 007, including its warning: `time` is sized for
  // H100-class cards, so if a task is hand-widened onto A100_80GB the time limit
  // must be raised in the same breath or it is killed mid-run having produced
  // nothing.
  //
  //   python3 -m sweep src.experiments.molecules src/experiments/molecules/configs/011_m2_loose_ends.jsonc
  // ─────────────────────────────────────────────────────────────────────────

  "name": "011_m2_loose_ends",
  "results_dir": "src/experiments/molecules/results",

  "execution": {
    "mode": "sbatch",
    "sbatch": {
      "granularity": "per_config",
      "max_concurrent": 7,          // = the run count: array path, no throttle
      "partition": "frida",
      "account": "povejmo",
      "gpus": ["B300", "B200", "H100"],
      "gpus_per_config": 1,
      "cpus": 4,
      "mem": "32G",
      "time": "04:00:00",
      "container": "/shared/workspace/povejmo/containers/transformers_deepspeed_latest.sqsh"
    }
  },

  // A bundle: these keys vary TOGETHER, one dict per run. Not a cross product —
  // the two holes have different shapes and a product would invent six runs
  // nobody asked for (`stereo_assigned` x `bias: none`, and so on).
  "cell": [
    // Hole 1 — §3.2.8's four cells at seed 1.
    { "task": "longest_chain",   "arm": "graph", "bias": "spd+magnetic", "stereo_tags": true,  "seed": 1 },
    { "task": "longest_chain",   "arm": "graph", "bias": "spd",          "stereo_tags": true,  "seed": 1 },
    { "task": "longest_chain",   "arm": "graph", "bias": "none",         "stereo_tags": true,  "seed": 1 },
    { "task": "longest_chain",   "arm": "flat",  "bias": "none",         "stereo_tags": true,  "seed": 1 },

    // Hole 2 — gate A2's off/on contrast, plus the flat reference at the tuned recipe.
    { "task": "stereo_assigned", "arm": "graph", "bias": "spd+magnetic", "stereo_tags": true,  "seed": 0 },
    { "task": "stereo_assigned", "arm": "graph", "bias": "spd+magnetic", "stereo_tags": false, "seed": 0 },
    { "task": "stereo_assigned", "arm": "flat",  "bias": "none",         "stereo_tags": true,  "seed": 0 }
  ],

  "question_node": "on",
  "encoding": "rich_levi",
  "pool": "bace,bbbp",

  "train_size": 4000,
  "val_size": 500,
  "test_size": 1000,
  "data_seed": 0,

  "lr": 3e-5,
  "bias_lr": 5e-3,
  "lora": true,
  "lora_r": 16,

  // 40 epochs x 125 steps/epoch = 5000 steps. Matched to 006/007/008.
  "num_epochs": 40,
  "eval_steps": 200,
  "batch_size": 4,
  "accumulation_steps": 8,
  "num_workers": 3,

  "impl": "v2-flex",
  "flex_compile_mode": "max-autotune-no-cudagraphs",
  "max_spd": 32
}
