{
  // ───────────────────────────────────────────────────────────────────────────
  // 042 — TIER C AT THIS PACKAGE'S RECIPE AND A LARGER BUDGET. 3 runs.
  //
  //   python3 -m sweep src.experiments.molecules <this file>
  //
  // ── WHAT IT ANSWERS ────────────────────────────────────────────────────────
  //
  // Two things the instruct cells left open, and they are worth one run because
  // they share it:
  //
  // 1. **The recipe.** Warmup + `cosine_with_min_lr` to `lr/10` in a single run,
  //    which is what every other specialist in this package uses
  //    (`train.py`) — against the generalist harness's WSD-plus-anneal-fork.
  // 2. **The budget.** The 5,000-step instruct cells were NOT converged: held-out
  //    test BLEU-2 rose 0.388 -> 0.415 -> 0.457 across step 2,000, step 4,000 and
  //    the anneal, with validation rising alongside it the whole way and no peak.
  //    The reported number was a floor.
  //
  // ── THE LEARNING RATE IS RAISED, AND BY HOW MUCH IS ARITHMETIC ─────────────
  //
  // `lr` 2e-4, twice the WSD arm's 1e-4, because the two schedules spend their
  // budget at different average rates and holding the PEAK fixed would not hold
  // the dose fixed. Integrated over the schedules as they actually run — `041`'s
  // 366 warmup / 2,931 stable / 366 decay, and this run's 407 warmup then cosine
  // to `lr/10` — the mean factors are **0.9101** and **0.5458** of peak, a ratio
  // of **1.667**. So 2x is a deliberate slight over-correction rather than a
  // guess, and 3x would overshoot the thing it corrects.
  //
  // An earlier draft of this comment cited 1.72, computed against a WSD arm that
  // never annealed (§6c) and therefore spent 0.94 of peak. The defect moved the
  // ratio by 0.05, which is why 2x survives the fix unchanged.
  //
  // ── THE BUDGET ─────────────────────────────────────────────────────────────
  //
  // 12 epochs against the control's 9, so ~1.33x the exposure. Sized to finish
  // inside the window on two cards rather than to a round number of steps; the
  // question is whether MORE budget helps, and 1.33x answers that as well as 2x
  // would.
  //
  // ── SELECTION IS ON DEV BLEU, AFTER THE RUN ────────────────────────────────
  //
  // Cosine anneals to a floor, so unlike WSD its last checkpoint is not
  // privileged and the run should be read at its best DEV point. A caption has no
  // dev metric the Trainer can compute — BLEU needs generation — so Tier C keeps
  // six checkpoints, does not restore a best one during training, and
  // `chebi_score.py --run-dir ... --split val` picks the winner by generating.
  // Selecting on `eval_loss` would optimise a different quantity than the number
  // reported, which is the defect `train.py::TIER_METRIC` already records once.
  //
  // ── RE-RUN 2026-09-18: WARMUP WAS TWICE ITS INTENDED LENGTH ────────────────
  //
  // The same world-size-blind `steps_per_epoch` that stranded `041`'s anneal
  // reached this config too, but far more gently: cosine derives its decay curve
  // from the Trainer's own step count, so the curve was correct and only
  // `warmup_steps` was wrong — 814 steps, two real epochs, where the recipe is
  // one. A deviation rather than a defect, and the reported 0.4229 is a genuinely
  // annealed model. It is re-run anyway, because `043`/`044` train on the
  // corrected code and a 2x2 whose cells disagree about warmup is not a 2x2.
  // Pre-fix results are under `results/_superseded_noanneal/`.
  // ───────────────────────────────────────────────────────────────────────────

  "name": "042_chebi_cosine_2x",
  "results_dir": "src/experiments/molecules/results",

  "execution": {
    "mode": "sbatch",
    "sbatch": {
      "granularity": "per_config",
      "max_concurrent": 3,
      "partition": "frida",
      "account": "povejmo",
      "gpus": ["B200", "B300", "H100"],
      "gpus_per_config": 2,
      "cpus": 8,
      "mem": "128G",
      "time": "10:00:00",
      "container": "/shared/workspace/povejmo/containers/transformers_deepspeed_latest.sqsh"
    }
  },

  "task": "chebi20",
  "arm_recipe": [
    { "arm": "graph", "bias": "spd+magnetic", "encoding": "rich_levi",
      "lr": 2e-4, "bias_lr": 2e-2 }
  ],
  "seed": [0, 1, 2],

  "model_name": "meta-llama/Llama-3.2-1B",
  "prompt_style": "plain",

  "chebi_heavy_atom_cap": 128,
  "chebi_allow_disconnected": true,

  "data_seed": 0,
  "question_node": "on",
  "num_epochs": 12,
  "lr_schedule": "cosine",
  "eval_steps": 1400,
  "batch_size": 4,
  "accumulation_steps": 8,
  "lora": true,
  "lora_r": 16,
  "num_workers": 3,
  "impl": "v2-flex",
  "flex_compile_mode": "max-autotune-no-cudagraphs",
  "max_spd": 32,
  "magnetic_dim": 32,
  "magnetic_q": 0.25
}
