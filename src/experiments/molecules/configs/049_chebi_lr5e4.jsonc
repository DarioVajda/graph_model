{
  // ───────────────────────────────────────────────────────────────────────────
  // 049 — EXTENDING THE `lr` BRACKET UPWARD. 2 runs (one cell, two seeds).
  //
  //   python3 -m sweep src.experiments.molecules <this file>
  //
  // ── WHY ────────────────────────────────────────────────────────────────────
  //
  // `048` screened `lr` {5e-5, 2e-4} x `bias_lr` {5e-3, 2e-2} and 2e-4 won by
  // +0.0637 BLEU-2 on dev — at the TOP EDGE of its bracket. §8.4's rule is that
  // an argmax at a bracket edge means the bracket was wrong, and the curves say
  // the same thing independently: all four 2e-4 runs peak at their LAST
  // checkpoint and are still climbing, while all four 5e-5 runs peaked at
  // 3,500-4,200 and turned over. So 2e-4 is the ceiling of what was measured, not
  // an optimum.
  //
  // One point rather than a bracket of two, because the question is directional —
  // does the climb continue past 2e-4 — and one point answers it. 5e-4 is 2.5x the
  // incumbent, a large enough step to move the result further than a seed draw
  // (+-0.0012 measured on the winning cell's test number) by a wide margin. If it
  // wins, the bracket extends again; if it loses, the optimum is bracketed between
  // 2e-4 and 5e-4 and the next screen is interior.
  //
  // ── `bias_lr` STAYS AT 5e-3, AND ABSOLUTE ──────────────────────────────────
  //
  // `048` measured 5e-3 beating 2e-2 by +0.0257 BLEU-2 with an interaction of
  // -0.0001, so the two axes compose and the winning `bias_lr` carries over
  // unchanged. It is held at an ABSOLUTE value rather than at a ratio to `lr`, as
  // `048` held it: the ratio therefore moves 25x -> 10x here, which is the point.
  // Every Tier-C config before `048` pinned `bias_lr` at 100x `lr` by inheritance,
  // and that inheritance is what the screen just showed was costing 0.029 BLEU-2
  // on test.
  //
  // ── FOUR CARDS, AND THE ARITHMETIC THAT MAKES IT THE SAME RECIPE ───────────
  //
  // An optimizer step consumes `batch_size x accumulation_steps x world_size`
  // examples. `042` and `048` ran 64 (4 x 8 x 2), which is what makes 12 epochs
  // 4,884 steps. Four cards therefore take `accumulation_steps` 8 -> 4, holding
  // 64 examples per step and 4,884 steps, with each rank doing half the sequential
  // micro-batches — the same recipe, twice as fast.
  //
  // SIX CARDS WERE CONSIDERED AND ARE NOT POSSIBLE: 64/6 is not an integer, so no
  // `accumulation_steps` holds the step size, and a cell that silently moves its
  // batch size is not an extension of this bracket. Eight cards work by the same
  // arithmetic (`accum` 2) and were rejected only on scheduling — no node had
  // eight free cards at submission, and a whole-node request that queues is slower
  // end to end than four cards that start immediately.
  //
  // ── READ THE SAME WAY AS `048` ─────────────────────────────────────────────
  //
  // Last checkpoint, no dev selection. `eval_steps` 700 as in `048`, so the
  // checkpoint grid matches. Test scoring and the published-protocol rescore are
  // chained onto this job rather than run by hand.
  //
  // The val scoring of the last checkpoint runs BESIDE the test scoring, and the
  // choice between 2e-4 and 5e-4 is made on VAL. Reporting the better of two test
  // numbers would be selection on test, which is the defect this project already
  // carries once elsewhere; the test number exists to be reported for whichever
  // cell val picks, not to pick it.
  // ───────────────────────────────────────────────────────────────────────────

  "name": "049_chebi_lr5e4",
  "results_dir": "src/experiments/molecules/results",

  "execution": {
    "mode": "sbatch",
    "sbatch": {
      "granularity": "per_config",
      "max_concurrent": 2,
      "partition": "frida",
      "account": "povejmo",
      "gpus": ["B200", "B300", "H100"],
      "gpus_per_config": 4,
      "cpus": 16,
      "mem": "256G",
      "time": "04:00:00",
      "container": "/shared/workspace/povejmo/containers/transformers_deepspeed_latest.sqsh"
    }
  },

  "task": "chebi20",
  "arm_recipe": [
    { "arm": "graph", "bias": "spd+magnetic", "encoding": "rich_levi",
      "lr": 5e-4, "bias_lr": 5e-3 }
  ],
  "seed": [0, 1],

  "model_name": "meta-llama/Llama-3.2-1B",
  "prompt_style": "plain",

  "chebi_heavy_atom_cap": 128,
  "chebi_allow_disconnected": true,

  "data_seed": 0,
  "question_node": "on",
  "num_epochs": 12,
  "lr_schedule": "cosine",
  "eval_steps": 700,
  "batch_size": 4,
  "accumulation_steps": 4,
  "lora": true,
  "lora_r": 16,
  "num_workers": 3,
  "impl": "v2-flex",
  "flex_compile_mode": "max-autotune-no-cudagraphs",
  "max_spd": 32,
  "magnetic_dim": 32,
  "magnetic_q": 0.25
}
