{
  // ─────────────────────────────────────────────────────────────────────────
  // D2 (PLAN §3.1) — magnetic bias SHARING GRANULARITY on GraphQA.
  //
  // Sweeps `magnetic_groups` G: the magnetic bias is instantiated G times
  // instead of once per layer, layer l served by group l*G//L. Llama-3.2-1B has
  // 16 layers, so G ∈ {1,2,4,8,16} are exactly the divisors, and the two
  // endpoints coincide with the pre-existing flags:
  //
  //     G = 16  ==  per-layer `magnetic`   (the headline arm)
  //     G = 1   ==  `magnetic_shared`
  //
  // `magnetic_groups: 0` is the LEGACY per-layer code path, run as the baseline.
  // It must land on the same accuracy as G=16 (tests/models/test_bias_sharing.py
  // pins that numerically); running it here also gives the old-vs-new step-time
  // delta on the same card, which is the point of re-running baselines at all.
  //
  // RECIPE: 006_question_node_ablation verbatim — isolated question node, the
  // standard graph encoding with all three biases on, v2-eager/fp32, LoRA r=16,
  // 20 epochs, seeds 42/43/44. `magnetic_groups` is a model-side knob only: it
  // does not touch feature generation or the dataset cache key, so every arm
  // trains on byte-identical data. Requires 005_question_node_data_prep's cache.
  //
  // TASKS: one per difficulty tier from the published table (CLAUDE_CONTEXT §3.1,
  // GTLM standard): node_degree 99.7 (easy), shortest_path 90.1 (medium),
  // edge_count 56.9 (hard). `triangle_counting` and `connected_nodes` are the
  // hard/relational tasks one would otherwise reach for — both are PLAN §3.3
  // permanent hold-outs, and selecting G on them would spend the only clean read
  // on generality. edge_count sits lower here than 56.9 because question_node
  // regresses it (a known magnetic-shortcut trade, not a bug); that is harmless
  // for a comparison where every arm shares the recipe, and leaves headroom.
  //
  // 3 tasks x 6 arms x 3 seeds = 54 runs, ~10 min each.
  //
  //   python3 -m sweep src.experiments.graphqa src/experiments/bias_sharing/configs/001_graphqa_g_sweep.jsonc
  //   python3 -m sweep.report src/experiments/bias_sharing/results/001_graphqa_g_sweep
  // ─────────────────────────────────────────────────────────────────────────

  "name": "001_graphqa_g_sweep",
  "results_dir": "src/experiments/bias_sharing/results",

  "execution": {
    "mode": "sbatch",
    "sbatch": {
      "granularity": "per_config",
      "max_concurrent": 12,
      "partition": "frida",
      "account": "povejmo",
      // ONE GPU TYPE for the whole sub-experiment. train_runtime_s is only
      // comparable across arms on identical hardware, and step time is half of
      // what D2 is measuring. A100 rather than H100/Blackwell: those were fully
      // allocated (003 holds all 8 of ixh, 002 is on B200), and this is by far
      // the cheapest of the three sub-experiments — 1B/fp32/LoRA r=16 at <=20
      // nodes and 1024 tokens fits 40 GB with room to spare. Running all three
      // in parallel beats queueing the cheap one behind the expensive one.
      // Do NOT compare s/it ACROSS sub-experiments.
      "gpus": "A100",
      "gpus_per_config": 1,
      "cpus": 8,
      "mem": "64G",
      "time": "04:00:00",
      "container": "/shared/workspace/povejmo/containers/transformers_deepspeed_latest.sqsh"
    }
  },

  "mode": "train",
  "question_node": "isolated",

  // ── axes ──────────────────────────────────────────────────────────────────
  "task": ["node_degree", "shortest_path", "edge_count"],
  "seed": [42, 43, 44],
  // THE axis under test. 0 = legacy per-layer path (baseline); 1..16 = grouped.
  "magnetic_groups": [0, 1, 2, 4, 8, 16],

  // ── the arm: 006's standard encoding with every bias on ───────────────────
  "graph_type": "standard",
  "spd": true,
  "rrwp": true,
  "magnetic": true,          // gates the eigenvector features; magnetic_groups
                             // supersedes it model-side when non-zero

  // ── the recipe (006_question_node_ablation, unchanged) ────────────────────
  "model_name": "meta-llama/Llama-3.2-1B",
  "impl": "v2-eager",
  "dtype": "fp32",
  "k_hop": 0,
  "lora": true,
  "lora_r": 16,
  "lora_dropout": 0.05,
  "num_epochs": 20,
  "batch_size": 4,
  "accumulation_steps": 8,
  "lr": 3e-5,
  "bias_lr": 5e-3,
  "eval_steps": 20,
  "max_steps": -1,
  "num_workers": 4,

  "max_spd": 8,
  "max_rw_steps": 16,
  "magnetic_dim": 32,
  "magnetic_q": 0.25,
  "magnetic_m": 0,

  "wandb_project": "GraphLLM"
}
