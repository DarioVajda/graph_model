{
  // ─────────────────────────────────────────────────────────────────────────
  // STEP 1 of the study (TODO.md §2 + §3), BOTH tasks in one sweep:
  //   2 tasks x 2 question_node modes x 3 seeds = 12 runs, all launched together.
  //
  //   python3 -m sweep src.experiments.our_tests src/experiments/our_tests/configs/003_question_node.jsonc
  //   python3 -m sweep.report src/experiments/our_tests/results/003_question_node
  //
  // It answers two questions at once:
  //   1. §3 correctness re-run — the `off` arm IS the paper's encoding on the fixed
  //      graph-bias reload path. Expect it at or ABOVE the published numbers
  //      (Family Tree 84.7 +/- 1.8, KG-QA 76.0 +/- 2.6), not merely equal: the old
  //      runs reported a best-adapter / end-of-run-bias pair that never existed.
  //   2. §2 question_node probe — does moving the question into its own edge-free
  //      prefix node (so graph tokens can attend to it) help?
  // The winner is chosen PER TASK and becomes the fixed `question_node` in
  // 004_ablation.jsonc, independently for family and kg_qa.
  //
  // DATA PROVENANCE (kg_qa only): graph_datasets/dataset_30-50/ was regenerated
  // locally (gen_seed 42) because the paper's own build lives on another HPC — see
  // that directory's PROVENANCE.md. The off-vs-isolated CONTRAST is unaffected (both
  // arms share one generator and seed), but a gap against the published KG-QA figure
  // mixes "reload fix" with "different data". The family dataset IS the paper's own.
  // ─────────────────────────────────────────────────────────────────────────

  "name": "003_question_node",
  "results_dir": "src/experiments/our_tests/results",

  "execution": {
    "mode": "sbatch",
    "sbatch": {
      "granularity": "per_config",
      "max_concurrent": 12,          // 12 jobs, all in flight at once
      "partition": "frida",
      "account": "povejmo",
      // Pinned to one brand: train_runtime_s is only comparable within a brand.
      "gpus": ["B300:1"],
      "cpus": 8,
      "mem": "64G",
      "time": "12:00:00",
      "container": "/shared/workspace/povejmo/containers/transformers_deepspeed_latest.sqsh"
    }
  },

  "mode": "train",

  // ── axes ──────────────────────────────────────────────────────────────────
  // task is a BUNDLE, not a bare axis: the two tasks have different published
  // learning rates, so `task` must carry its LRs with it. As a plain axis over one
  // top-level `lr`, half the runs would silently train at the wrong recipe.
  "task_recipe": [
    // family lr is DELIBERATELY 1e-4, not the paper's 5e-5 (config.py::validate()
    // will print a deviation warning for it — that warning is expected here).
    { "task": "family", "lr": 1e-4, "bias_lr": 1e-2 },
    { "task": "kg_qa",  "lr": 5e-4, "bias_lr": 3e-2 }
  ],
  "question_node": ["off", "isolated"],
  "seed": [0, 1, 2],

  // ── all biases on: this is the base arm, not an ablation cell ─────────────
  "spd": true,
  "rrwp": true,
  "magnetic": true,

  // ── the recipe (lr/bias_lr live in the task_recipe bundle above) ──────────
  "model_name": "meta-llama/Llama-3.2-1B",
  "impl": "v2-eager",
  "dtype": "fp32",
  "k_hop": 0,
  "lora": true,
  "lora_r": 32,          // paper: rank 32 / alpha 64 (alpha is derived as 2*r)
  "lora_dropout": 0.15,  // raised from the paper's 0.05 for both tasks
  "num_epochs": 10,
  "batch_size": 4,
  "accumulation_steps": 4,
  "eval_steps": 40,
  "max_steps": -1,
  "num_workers": 4,

  // ── bias architecture ─────────────────────────────────────────────────────
  "max_spd": 8,
  "max_rw_steps": 16,
  "magnetic_dim": 32,
  "magnetic_q": 0.25,
  "magnetic_m": 0,

  "wandb_project": "GraphLLM"
}
