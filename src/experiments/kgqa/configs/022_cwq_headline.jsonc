{
  // ─────────────────────────────────────────────────────────────────────────
  // E4.3 (TODO_cwq): CWQ-only headline arms — THE retrieval-matched CWQ
  // result vs SR-only GNN-RAG (Table 15(d): 55.6 Hits@1 / 53.3 F1).
  //
  // 3 seeds × {graph-native, flat collapsed-serialization (D2b winner)} on
  // the frozen 1B recipe + reg survivors (lora_dropout 0.15, wd fix), CWQ
  // caps from E1.1 (max_nodes 1024, n_max 50, versions 1), flat seq_len 8192
  // (covers 99.1-99.4%).
  //
  // num_epochs 8 (call of 2026-07-13): the 020 probe peaked at epoch 4.78
  // (dev-256 F1 0.583) and read flat through 6, but the plateau was short and
  // noisy — 8 buys headroom to confirm it. mem 200G: the probe hit host-RAM
  // OOM (MaxRSS 100.6G vs 96G) mid full-split eval after 18h.
  //
  //   python3 -m sweep src.experiments.kgqa src/experiments/kgqa/configs/022_cwq_headline.jsonc
  // ─────────────────────────────────────────────────────────────────────────
  "name": "cwq_headline",
  "results_dir": "src/experiments/kgqa/results",

  "execution": {
    "mode": "sbatch",
    "sbatch": {
      "granularity": "per_config",
      "max_concurrent": 6,
      "partition": "frida",
      "account": "povejmo",
      "gpus": "B300:1",
      "cpus": 8,
      "mem": "200G",
      "time": "48:00:00",
      "container": "/shared/workspace/povejmo/containers/transformers_deepspeed_latest.sqsh"
    }
  },

  "seed": [0, 1, 2],
  "arm": [
    { "mode": "train",      "cvt_collapse": null },
    { "mode": "flat_train", "cvt_collapse": true }   // D2b winner: collapsed serialization
  ],

  "dataset": "cwq",
  "max_nodes": 1024,
  "versions": 1,
  "n_max": 50,
  "data_seed": 42,
  "data_format_version": 3,

  "model_name": "meta-llama/Llama-3.2-1B",
  "rel_mode": "last_1",
  "num_epochs": 8,               // probe peaked 4.78, flat→6; +2 to test the plateau
  "batch_size": 2,
  "accumulation_steps": 4,
  "lr": 1e-4,
  "bias_lr": 5e-3,
  "lora_r": 64,
  "lora_dropout": 0.15,
  "bias_weight_decay": 0.0,
  "k_hop": 0,
  "graph_attn_impl": "flex",
  "dtype": "bf16",
  "gradient_checkpointing": true,
  "num_workers": 4,
  "seq_len": 8192,               // CWQ flat serialization: covers 99.1-99.4% (README)

  "eval_steps": 1000,
  "gen_eval_samples": 256,       // fixed seeded dev subsample for selection (E3.3)
  "gen_max_samples": null,       // final scoring: full splits
  "gen_max_new_tokens": 256,

  "wandb_project": "GraphLLM"
}
