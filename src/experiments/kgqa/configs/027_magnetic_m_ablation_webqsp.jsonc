{
  // ─────────────────────────────────────────────────────────────────────────
  // magnetic_m ablation (2026-07-14): does eigenvector truncation lose
  // information? Follow-up to 024_bias_ablation_webqsp.jsonc, which fixed
  // magnetic_m=128 for every arm — so the ~1pp F1 gap between magnetic and
  // magnetic_shared observed there is about placement (per-layer vs.
  // once-per-forward), NOT about m. This sweep varies m directly, holding
  // everything else at the frozen recipe.
  //
  // magnetic_m in {32, 64, 0} (0 = keep all eigenvectors, no truncation) x
  // {spd+magnetic, spd+magnetic_shared} x seed {0,1} = 12 runs. m=128 is
  // deliberately excluded — reuse the existing 3-seed 024 results for that
  // point instead of rerunning.
  //
  // Grid skews small: real WebQSP node counts (checked against the 024
  // .gtds cache) have median N ~55-60, and only ~24-26% of graphs exceed 128
  // nodes (~12-14% exceed 256) — so m=128 already keeps every eigenvector for
  // over half the dataset, and m=256/512 would only move the shrinking tail.
  // m=32/64 truncate 43-47% of graphs — that's where a real information-loss
  // signal, if any, should show up. m=16 was considered and dropped as
  // likely too small to be meaningful relative to magnetic_dim=128.
  //
  // Also expected to sharpen the magnetic_shared affordability read: the
  // per-layer magnetic bias einsum is O(N^2 * m) recomputed every layer, vs.
  // magnetic_shared paying it once per forward — so the speed gap between
  // the two should widen as m grows toward 0 (= unbounded, up to max_nodes).
  //
  // gpus: B200 or B300, whichever is free (see sweep's GPU-list support,
  // 4066ba8) — this sweep doesn't need a specific type.
  //
  // Requires 026_magnetic_m_data_prep.jsonc's caches to exist first.
  //
  //   python3 -m sweep src.experiments.kgqa src/experiments/kgqa/configs/027_magnetic_m_ablation_webqsp.jsonc
  // ─────────────────────────────────────────────────────────────────────────
  "name": "magnetic_m_ablation_webqsp",
  "results_dir": "src/experiments/kgqa/results",

  "execution": {
    "mode": "sbatch",
    "sbatch": {
      "granularity": "per_config",
      "max_concurrent": 12,
      "partition": "frida",
      "account": "povejmo",
      "gpus": ["B200:1", "B300:1"],
      "cpus": 8,
      "mem": "64G",
      "time": "24:00:00",
      "container": "/shared/workspace/povejmo/containers/transformers_deepspeed_latest.sqsh"
    }
  },

  "seed": [0, 1],
  "magnetic_m": [32, 64, 0],
  "arm": [
    { "spd": true, "magnetic": true,  "magnetic_shared": false },  // spd+magnetic
    { "spd": true, "magnetic": false, "magnetic_shared": true  }   // spd+magnetic_shared
  ],

  "mode": "train",
  "dataset": "webqsp",
  "max_nodes": 512,
  "versions": 8,
  "n_max": 50,
  "data_seed": 42,
  "data_format_version": 3,

  "model_name": "meta-llama/Llama-3.2-1B",
  "rel_mode": "last_1",
  "num_epochs": 15,
  "batch_size": 2,
  "accumulation_steps": 4,
  "lr": 1e-4,
  "bias_lr": 5e-3,
  "lora_r": 64,
  "lora_dropout": 0.15,
  "bias_weight_decay": 0.0,
  "k_hop": 0,
  "graph_attn_impl": "flex",
  "dtype": "bf16",
  "gradient_checkpointing": true,
  "num_workers": 4,
  "seq_len": 4096,

  "eval_steps": 200,
  "gen_eval_samples": null,
  "gen_max_samples": null,
  "gen_max_new_tokens": 256,

  "wandb_project": "GraphLLM"
}
