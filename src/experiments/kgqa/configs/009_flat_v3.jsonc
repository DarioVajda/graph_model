{
  // ─────────────────────────────────────────────────────────────────────────
  // D2.3 — text-serialization ablation runs (README goal #2 control arm).
  //
  // Same base LLM, same select_triples(512) subgraphs flattened to
  // 'h | r | t' lines (pre-Levi / pre-CVT-collapse), targets verified
  // byte-identical to the graph arm's (22 730/22 730 rows) — the control that
  // isolates whether the graph attention biases do anything.
  //
  // Training config = the graph arm's presumptive D1 winner (r64, lr 1e-4,
  // 15 ep, full-dev selection; decision logged in TODO.md) + one lr probe arm
  // (2e-4) since the flat loss surface may want its own lr.
  // If the winner lands within ~2 F1 of the graph arm -> extend to 3 seeds.
  //
  // Dataset must exist first (CPU, local):
  //   python3 -m src.experiments.kgqa --mode flat_data_prep
  //   python3 -m sweep src.experiments.kgqa src/experiments/kgqa/configs/009_flat_v3.jsonc
  // ─────────────────────────────────────────────────────────────────────────
  "name": "flat_v3",
  "results_dir": "src/experiments/kgqa/results",

  "execution": {
    "mode": "sbatch",
    "sbatch": {
      "granularity": "per_config",
      "max_concurrent": 3,
      "partition": "frida",
      "account": "povejmo",
      "gpus": "B300:1",
      "cpus": 8,
      "mem": "64G",
      "time": "24:00:00",
      "container": "/shared/workspace/povejmo/containers/transformers_deepspeed_latest.sqsh"
    }
  },

  "mode": "flat_train",
  "lr": [1e-4, 2e-4],

  "seed": 0,
  "lora_r": 64,
  "seq_len": 4096,
  "num_epochs": 15,
  "batch_size": 2,
  "accumulation_steps": 4,
  "num_workers": 4,
  "dtype": "bf16",
  "gradient_checkpointing": true,

  "data_format_version": 3,
  "rel_mode": "last_1",
  "max_nodes": 512,
  "n_max": 20,
  "versions": 8,
  "data_seed": 42,

  "eval_steps": 200,
  "gen_max_new_tokens": 128,
  "gen_eval_samples": null,
  "gen_max_samples": null,

  "wandb_project": "GraphLLM"
}
