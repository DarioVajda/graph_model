{
  // ─────────────────────────────────────────────────────────────────────────
  // Regularization round 2 (2026-07-11, after 015/016 round 1).
  //
  // Round-1 verdicts vs control (test F1 72.55 ± 0.22, 3 seeds):
  //   lora_do 0.15  -> 72.95 / 73.39  — ONLY arm above control (both seeds
  //                    beat every control seed): overfit lives in LoRA.
  //   wd 0.1        -> flat (72.57 / 72.02)      — harmless, dose too low?
  //   droppath 0.1  -> −4 pt                     — overdosed
  //   eig 0.1+mlp0.1-> −12..−15 pt               — heavily overdosed; per-layer
  //                    independent masks gave the net no consistent spectrum.
  //
  // Round-2 arms (mechanism fixes from the 2026-07-11 discussion):
  //   lora25            lora_dropout 0.25 — dose-response of the working lever
  //   wd3               bias_weight_decay 0.3 — one stronger probe
  //   eig_shared        eigvec 0.05, ONE mask per forward shared by all layers
  //                     (coherent spectral truncation), MLP dropout unbundled
  //   eig_shared_onset  same + reg_onset_frac 0.33 (channel forms cleanly for
  //                     the first third of training, dropout switches on late)
  //   droppath05        bias_droppath 0.05 — halved dose
  //   elem              bias_dropout 0.1 — element-wise (i,j) dropout on the
  //                     summed bias (gentlest corruption, channel always on)
  //
  // Base recipe identical to 013/015. Readout identical to Part 7 (dev/test +
  // train-slice on best checkpoints vs the same controls).
  //   python3 -m sweep src.experiments.kgqa src/experiments/kgqa/configs/017_reg_round2.jsonc
  // ─────────────────────────────────────────────────────────────────────────
  "name": "reg_round2",
  "results_dir": "src/experiments/kgqa/results",

  "execution": {
    "mode": "sbatch",
    "sbatch": {
      "granularity": "per_config",
      "max_concurrent": 16,
      "partition": "frida",
      "account": "povejmo",
      "gpus": "B300:1",
      "cpus": 8,
      "mem": "64G",
      "time": "24:00:00",
      "container": "/shared/workspace/povejmo/containers/transformers_deepspeed_latest.sqsh"
    }
  },

  "seed": [0, 1, 2],

  // Every object pins all probe knobs explicitly so run names self-describe.
  "arm": [
    { "lora_dropout": 0.25, "bias_weight_decay": 0.0, "magnetic_eigvec_dropout": 0.0,  "magnetic_eigvec_shared_mask": false, "magnetic_mlp_dropout": 0.0, "bias_droppath": 0.0,  "bias_dropout": 0.0, "reg_onset_frac": 0.0 },
    { "lora_dropout": 0.05, "bias_weight_decay": 0.3, "magnetic_eigvec_dropout": 0.0,  "magnetic_eigvec_shared_mask": false, "magnetic_mlp_dropout": 0.0, "bias_droppath": 0.0,  "bias_dropout": 0.0, "reg_onset_frac": 0.0 },
    { "lora_dropout": 0.05, "bias_weight_decay": 0.0, "magnetic_eigvec_dropout": 0.05, "magnetic_eigvec_shared_mask": true,  "magnetic_mlp_dropout": 0.0, "bias_droppath": 0.0,  "bias_dropout": 0.0, "reg_onset_frac": 0.0 },
    { "lora_dropout": 0.05, "bias_weight_decay": 0.0, "magnetic_eigvec_dropout": 0.05, "magnetic_eigvec_shared_mask": true,  "magnetic_mlp_dropout": 0.0, "bias_droppath": 0.0,  "bias_dropout": 0.0, "reg_onset_frac": 0.33 },
    { "lora_dropout": 0.05, "bias_weight_decay": 0.0, "magnetic_eigvec_dropout": 0.0,  "magnetic_eigvec_shared_mask": false, "magnetic_mlp_dropout": 0.0, "bias_droppath": 0.05, "bias_dropout": 0.0, "reg_onset_frac": 0.0 },
    { "lora_dropout": 0.05, "bias_weight_decay": 0.0, "magnetic_eigvec_dropout": 0.0,  "magnetic_eigvec_shared_mask": false, "magnetic_mlp_dropout": 0.0, "bias_droppath": 0.0,  "bias_dropout": 0.1, "reg_onset_frac": 0.0 }
  ],

  "mode": "train",
  "lora_r": 64,
  "lr": 1e-4,
  "bias_lr": 5e-3,
  "k_hop": 0,
  "rel_mode": "last_1",
  "num_epochs": 15,
  "batch_size": 2,
  "accumulation_steps": 4,
  "num_workers": 4,
  "graph_attn_impl": "flex",
  "dtype": "bf16",
  "gradient_checkpointing": true,
  "seq_len": 4096,

  "data_format_version": 3,
  "n_max": 50,
  "gen_max_new_tokens": 256,
  "max_nodes": 512,
  "versions": 8,
  "data_seed": 42,

  "eval_steps": 200,
  "gen_eval_samples": null,
  "gen_max_samples": null,

  "wandb_project": "GraphLLM"
}
