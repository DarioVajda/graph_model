{
  // ─────────────────────────────────────────────────────────────────────────
  // Bias ablation (2026-07-13): the same 6 bias arms as the probe suite
  // (src/experiments/probes/configs/suite.jsonc), run on the frozen WebQSP
  // graph-native recipe. Two purposes:
  //
  //   1. Affordability check for `magnetic_shared` — the probe suite measured
  //      it cheaper than per-layer `magnetic` in wall-clock s/it and peak GB
  //      on synthetic graphs; this sweep is the same comparison at KGQA's
  //      real max_nodes=512 / 15-epoch operating point, to decide whether we
  //      can switch the frozen recipe to it. Read wall-clock + peak-mem off
  //      the Slurm job logs / wandb run duration (not logged to runs.jsonl
  //      here — kgqa's train.py doesn't instrument step timing the way the
  //      probes' train.py does).
  //   2. Ablation — which bias term actually drives WebQSP F1/Hits@1, holding
  //      everything else (data-format v3, lora_dropout 0.15, wd fix, r64,
  //      15 ep, full-dev selection) at the current frozen recipe.
  //
  // kgqa didn't support `magnetic_shared` or the bias-free `none` arm before
  // this sweep (RunConfig only had separate `spd`/`magnetic` bools, and
  // validate() required at least one on) — both are now wired through
  // (config.py: `magnetic_shared` field + bias_params() branch; validate()
  // now only rejects `magnetic` + `magnetic_shared` together, not all-off).
  //
  // graph-native only (mode "train"): bias arms don't apply to flat_train.
  // Everything else pinned to 021_webqsp_recipe_refresh.jsonc's frozen recipe.
  //
  //   python3 -m sweep src.experiments.kgqa src/experiments/kgqa/configs/024_bias_ablation_webqsp.jsonc
  // ─────────────────────────────────────────────────────────────────────────
  "name": "bias_ablation_webqsp",
  "results_dir": "src/experiments/kgqa/results",

  "execution": {
    "mode": "sbatch",
    "sbatch": {
      "granularity": "per_config",
      "max_concurrent": 18,
      "partition": "frida",
      "account": "povejmo",
      "gpus": "B300:1",
      "cpus": 8,
      "mem": "64G",
      "time": "24:00:00",
      "container": "/shared/workspace/povejmo/containers/transformers_deepspeed_latest.sqsh"
    }
  },

  "seed": [0, 1, 2],
  "arm": [
    { "spd": false, "magnetic": false, "magnetic_shared": false },  // none
    { "spd": true,  "magnetic": false, "magnetic_shared": false },  // spd
    { "spd": false, "magnetic": true,  "magnetic_shared": false },  // magnetic
    { "spd": true,  "magnetic": true,  "magnetic_shared": false },  // spd+magnetic
    { "spd": false, "magnetic": false, "magnetic_shared": true  },  // magnetic_shared
    { "spd": true,  "magnetic": false, "magnetic_shared": true  }   // spd+magnetic_shared
  ],

  "mode": "train",
  "dataset": "webqsp",
  "max_nodes": 512,
  "versions": 8,
  "n_max": 50,
  "data_seed": 42,
  "data_format_version": 3,

  "model_name": "meta-llama/Llama-3.2-1B",
  "rel_mode": "last_1",
  "num_epochs": 15,
  "batch_size": 2,
  "accumulation_steps": 4,
  "lr": 1e-4,
  "bias_lr": 5e-3,
  "lora_r": 64,
  "lora_dropout": 0.15,
  "bias_weight_decay": 0.0,
  "k_hop": 0,
  "graph_attn_impl": "flex",
  "dtype": "bf16",
  "gradient_checkpointing": true,
  "num_workers": 4,
  "seq_len": 4096,

  "eval_steps": 200,
  "gen_eval_samples": null,          // full 246-question dev per checkpoint (historical protocol)
  "gen_max_samples": null,
  "gen_max_new_tokens": 256,

  "wandb_project": "GraphLLM"
}
