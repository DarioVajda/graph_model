{
  // ─────────────────────────────────────────────────────────────────────────
  // E4.2 (TODO_cwq, 2026-07-12): CWQ epoch/convergence probe.
  //
  // One seed, graph arm, CWQ-only, to find where dev F1 flattens (expected
  // ≪15 epochs at 27.6k train questions; the call of 2026-07-12 is to
  // train SHORT — this probe runs 6 epochs and the readout decides the frozen
  // CWQ schedule for the E4.3 headline arms). versions=1 per the near-
  // singleton-answer-set argument (the ver8 augmentation is a no-op on CWQ).
  //
  // Recipe = frozen 1B recipe + the reg-campaign survivors:
  //   r64, lr 1e-4, bias_lr 5e-3, k_hop 0, lora_dropout 0.15 (the one reg
  //   winner), bias_weight_decay 0 (fix kept, value 0), dfv3, n_max 50,
  //   CWQ max_nodes 1024 (E1.1 knee), full metrics dataset-prefixed.
  //
  // Eval cadence: ~3455 optimizer steps/epoch (27639 q / (2×4)); eval every
  // 1000 steps ≈ 3-4 dev readings/epoch, ~21 over the run. In-training
  // generative eval on a fixed seeded 256-question dev subsample (E3.3);
  // final scoring full-split.
  //
  //   python3 -m sweep src.experiments.kgqa src/experiments/kgqa/configs/020_cwq_epoch_probe.jsonc
  // ─────────────────────────────────────────────────────────────────────────
  "name": "cwq_epoch_probe",
  "results_dir": "src/experiments/kgqa/results",

  "execution": {
    "mode": "sbatch",
    "sbatch": {
      "granularity": "per_config",
      "partition": "frida",
      "account": "povejmo",
      "gpus": "B300:1",
      "cpus": 8,
      "mem": "96G",
      "time": "48:00:00",
      "container": "/shared/workspace/povejmo/containers/transformers_deepspeed_latest.sqsh"
    }
  },

  "mode": "train",
  "dataset": "cwq",
  "max_nodes": 1024,
  "versions": 1,
  "n_max": 50,
  "data_seed": 42,
  "data_format_version": 3,

  "model_name": "meta-llama/Llama-3.2-1B",
  "rel_mode": "last_1",
  "seed": 0,
  "num_epochs": 6,
  "batch_size": 2,
  "accumulation_steps": 4,
  "lr": 1e-4,
  "bias_lr": 5e-3,
  "lora_r": 64,
  "lora_dropout": 0.15,
  "bias_weight_decay": 0.0,
  "k_hop": 0,
  "graph_attn_impl": "flex",
  "dtype": "bf16",
  "gradient_checkpointing": true,
  "num_workers": 4,

  "eval_steps": 1000,
  "gen_eval_samples": 256,
  "gen_max_samples": null,
  "gen_max_new_tokens": 256,

  "wandb_project": "GraphLLM"
}
