{
  // ─────────────────────────────────────────────────────────────────────────
  // Data-format v3 attribution sweep + the first-ever seed-noise measurement
  // (B5 of the TODO roadmap; decisions 2026-07-07: 9 runs, single v3 arm).
  //
  // 3 data arms x 3 seeds at the cheap k=0 operating point (15 epochs — the
  // 66.5±0.7 plateau is reachable there; full-dev checkpoint selection):
  //   * v2-control — data_format_version 2 (comma-joined targets, comma
  //     parsing) + naming_version 1. Both are cache-key fields, so this arm
  //     rebuilds reproducibly from entities_names.v1.json in any order — it no
  //     longer depends on a fossil cache predating naming v2.
  //   * v3 — newline separator + naming v2 (entities_names.json extended with
  //     FB5M / in-data Freebase aliases; fixes the 76 collapse-lost golds).
  //   * v3 recall arm — n_max=50 (questions with >5 present golds averaged
  //     12.8 preds vs more golds); gen budget doubled so the longer target
  //     sets fit (only 14/1628 v2 generations hit the 128 cap; 50 newline-
  //     joined answers need more).
  // Seeds give the sweep's OTHER payoff: the seed-noise bar that retroactively
  // calibrates every past "within noise" claim.
  //
  // At smoke time, eyeball v3 generations for "\n\n" drift (the parser drops
  // empty segments regardless).
  //
  // Datasets must exist first (results/dataprep_v3 jobs; _dfv2 already built):
  //   python3 -m sweep src.experiments.kgqa src/experiments/kgqa/configs/attribution_v3.jsonc
  //   python3 -m sweep.report src/experiments/kgqa/results/attribution_v3
  // ─────────────────────────────────────────────────────────────────────────
  "name": "attribution_v3",
  "results_dir": "src/experiments/kgqa/results",

  "execution": {
    "mode": "sbatch",
    "sbatch": {
      "granularity": "per_config",
      "max_concurrent": 6,
      "partition": "frida",
      "account": "povejmo",
      "gpus": "B300:1",
      "cpus": 8,
      "mem": "64G",
      "time": "12:00:00",
      "container": "/shared/workspace/povejmo/containers/transformers_deepspeed_latest.sqsh"
    }
  },

  // ── axes ──────────────────────────────────────────────────────────────────
  "mode": "train",
  "seed": [0, 1, 2],
  "data_arm": [
    { "data_format_version": 2, "naming_version": 1, "n_max": 20, "gen_max_new_tokens": 128 },
    { "data_format_version": 3, "naming_version": 2, "n_max": 20, "gen_max_new_tokens": 128 },
    { "data_format_version": 3, "naming_version": 2, "n_max": 50, "gen_max_new_tokens": 256 }
  ],

  // ── fixed: cheap k=0 operating point ─────────────────────────────────────
  "k_hop": 0,
  "rel_mode": "last_1",
  "lora_r": 16,
  "lr": 1e-4,
  "bias_lr": 5e-3,
  "num_epochs": 15,
  "batch_size": 2,
  "accumulation_steps": 4,
  "num_workers": 4,
  "graph_attn_impl": "flex",
  "dtype": "bf16",
  "gradient_checkpointing": true,

  // data config: dfv2/dfv3 + n_max come from the bundle; the rest at defaults.
  "max_nodes": 512,
  "versions": 8,
  "data_seed": 42,

  // ── eval schedule: full-dev selection ─────────────────────────────────────
  // eval_steps=200 -> ~24 selection points over ~4800 steps; gen_eval_samples
  // null -> gen_max_samples null -> FULL dev for selection AND final scoring.
  "eval_steps": 200,
  "gen_eval_samples": null,
  "gen_max_samples": null,

  "wandb_project": "GraphLLM"
}
