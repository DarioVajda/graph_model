{
  // ─────────────────────────────────────────────────────────────────────────
  // E4.4 prerequisite (TODO_cwq addendum, 2026-07-12): webqsp-only cells of
  // the transfer matrix, RE-RUN under the updated recipe.
  //
  // The recipe moved after D2b (graph-bias weight-decay fix, lora_dropout
  // 0.15, dataset-prefixed metrics), so the matrix's webqsp-only cells can't
  // reuse D2b history without confounding recipe with dataset roles. 3 seeds
  // × {graph-native, flat collapsed-serialization (the D2b winner)} —
  // everything else stays the frozen WebQSP recipe (15 ep; WebQSP is
  // data-poor, the short-schedule call applies to CWQ only).
  //
  //   python3 -m sweep src.experiments.kgqa src/experiments/kgqa/configs/021_webqsp_recipe_refresh.jsonc
  // ─────────────────────────────────────────────────────────────────────────
  "name": "webqsp_recipe_refresh",
  "results_dir": "src/experiments/kgqa/results",

  "execution": {
    "mode": "sbatch",
    "sbatch": {
      "granularity": "per_config",
      "max_concurrent": 6,
      "partition": "frida",
      "account": "povejmo",
      "gpus": "B300:1",
      "cpus": 8,
      "mem": "64G",
      "time": "24:00:00",
      "container": "/shared/workspace/povejmo/containers/transformers_deepspeed_latest.sqsh"
    }
  },

  "seed": [0, 1, 2],
  "arm": [
    { "mode": "train",      "cvt_collapse": null },
    { "mode": "flat_train", "cvt_collapse": true }   // D2b winner: collapsed serialization
  ],

  "dataset": "webqsp",
  "max_nodes": 512,
  "versions": 8,
  "n_max": 50,
  "data_seed": 42,
  "data_format_version": 3,

  "model_name": "meta-llama/Llama-3.2-1B",
  "rel_mode": "last_1",
  "num_epochs": 15,
  "batch_size": 2,
  "accumulation_steps": 4,
  "lr": 1e-4,
  "bias_lr": 5e-3,
  "lora_r": 64,
  "lora_dropout": 0.15,
  "bias_weight_decay": 0.0,
  "k_hop": 0,
  "graph_attn_impl": "flex",
  "dtype": "bf16",
  "gradient_checkpointing": true,
  "num_workers": 4,
  "seq_len": 4096,

  "eval_steps": 200,
  "gen_eval_samples": null,          // full 246-question dev per checkpoint (historical protocol)
  "gen_max_samples": null,
  "gen_max_new_tokens": 256,

  "wandb_project": "GraphLLM"
}
