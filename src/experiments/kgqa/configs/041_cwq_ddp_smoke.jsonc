{
  // ─────────────────────────────────────────────────────────────────────────
  // DDP smoke (2026-09-19): the first multi-GPU run of the KGQA graph arm.
  // Every KGQA run to date is gpus_per_config 1, and a CWQ graph run at 8
  // epochs costs ~22 h on one B300 — the headline is only reachable inside a
  // night if one run spans a node, so this checks that the pieces survive
  // torchrun before anything long is committed:
  //
  //   1. process-group init with the flex-attention graph path,
  //   2. a few optimizer steps,
  //   3. the generative eval (rank-naive by construction — `_generative_metrics`
  //      passes the UNWRAPPED `self.model`, so `.generate` works on every rank
  //      and no rank waits on a collective the others skip),
  //   4. the final full-split scoring + record write.
  //
  // batch_size 1 x accumulation_steps 1 is the headline's DDP shape: at 8 ranks
  // one optimizer step consumes 8 examples, exactly the 2 x 4 of 022 on one
  // GPU. Same effective batch, same step count, same schedule — the recipe
  // transfers unchanged and only wall-clock moves.
  //
  // Runs off 022's existing cap1024 cache (no question node), so it needs no
  // build and is a like-for-like check of the machinery.
  //
  //   python3 -m sweep src.experiments.kgqa src/experiments/kgqa/configs/041_cwq_ddp_smoke.jsonc
  // ─────────────────────────────────────────────────────────────────────────
  "name": "cwq_ddp_smoke",
  "results_dir": "src/experiments/kgqa/results",

  "execution": {
    "mode": "sbatch",
    "sbatch": {
      "granularity": "per_config",
      "partition": "frida",
      "account": "povejmo",
      "gpus": ["B200", "B300"],
      "gpus_per_config": 2,
      "cpus": 16,
      "mem": "200G",
      "time": "01:00:00",
      "container": "/shared/workspace/povejmo/containers/transformers_deepspeed_latest.sqsh"
    }
  },

  "mode": "train",
  "max_steps": 4,
  "eval_steps": 2,
  "num_epochs": 1,

  "dataset": "cwq",
  "max_nodes": 1024,
  "versions": 1,
  "n_max": 50,
  "data_seed": 42,
  "data_format_version": 3,

  "model_name": "meta-llama/Llama-3.2-1B",
  "rel_mode": "last_1",
  "lr": 1e-4,
  "bias_lr": 5e-3,
  "lora_r": 64,
  "lora_dropout": 0.15,
  "bias_weight_decay": 0.0,
  "k_hop": 0,
  "batch_size": 1,
  "accumulation_steps": 1,
  "graph_attn_impl": "flex",
  "dtype": "bf16",
  "gradient_checkpointing": true,
  "num_workers": 4,

  "gen_eval_samples": 8,
  "gen_max_samples": 16,
  "gen_max_new_tokens": 64,

  "wandb_project": null
}
