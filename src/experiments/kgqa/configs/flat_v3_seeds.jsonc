{
  // ─────────────────────────────────────────────────────────────────────────
  // D2.3 extension (2026-07-09): the flat arm landed WITHIN 2 F1 of the graph
  // arm at seed 0 (test F1 73.10 @ lr 1e-4 vs graph r64 71.90 / best 72.50)
  // -> extend to 3 seeds for the real comparison. lr probe verdict: 1e-4 ≥
  // 2e-4 (73.10 vs 72.96 test) — keep 1e-4, same as the graph arm.
  //   python3 -m sweep src.experiments.kgqa src/experiments/kgqa/configs/flat_v3_seeds.jsonc
  // ─────────────────────────────────────────────────────────────────────────
  "name": "flat_v3_seeds",
  "results_dir": "src/experiments/kgqa/results",

  "execution": {
    "mode": "sbatch",
    "sbatch": {
      "granularity": "per_config",
      "max_concurrent": 2,
      "partition": "frida",
      "account": "povejmo",
      "gpus": "B300:1",
      "cpus": 8,
      "mem": "64G",
      "time": "24:00:00",
      "container": "/shared/workspace/povejmo/containers/transformers_deepspeed_latest.sqsh"
    }
  },

  "mode": "flat_train",
  "seed": [1, 2],

  "lr": 1e-4,
  "lora_r": 64,
  "seq_len": 4096,
  "num_epochs": 15,
  "batch_size": 2,
  "accumulation_steps": 4,
  "num_workers": 4,
  "dtype": "bf16",
  "gradient_checkpointing": true,

  "data_format_version": 3,
  "rel_mode": "last_1",
  "max_nodes": 512,
  "n_max": 20,
  "versions": 8,
  "data_seed": 42,

  "eval_steps": 200,
  "gen_max_new_tokens": 128,
  "gen_eval_samples": null,
  "gen_max_samples": null,

  "wandb_project": "GraphLLM"
}
